    "Swap the needles between your hands and work back the other way": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدّل الإبر بين يديك واحِك راجعًا في الاتجاه الآخر"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হাতে কাঁটা বদলান এবং উল্টো দিকে ফিরে বুনুন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Canviar les agulles de mà i treballar en sentit contrari"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyměnit jehlice v rukou a plést zpět opačným směrem"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift pindene mellem hænderne og strik tilbage i den modsatte retning"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nadeln in den Händen tauschen und in die andere Richtung zurückstricken"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άλλαξε τις βελόνες ανάμεσα στα χέρια και δούλεψε πίσω προς την άλλη κατεύθυνση"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar las agujas de mano y tejer de vuelta en el otro sentido"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar las agujas de mano y tejer de vuelta en el otro sentido"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda puikot käsien välillä ja neulo takaisin toiseen suuntaan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer les aiguilles de main et tricoter en sens inverse"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer les aiguilles de main et tricoter en sens inverse"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હાથમાં સળીઓ બદલો અને બીજી દિશામાં પાછા ગૂંથો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלף את המסרגות בין הידיים וסרוג חזרה לכיוון השני"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सलाइयों को हाथों में बदलें और दूसरी दिशा में वापस बुनें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamijeniti igle u rukama i plesti natrag u drugom smjeru"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tűk cseréje a kezeid között és kötés visszafelé"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukar jarum antar tangan dan kerjakan balik ke arah lain"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scambiare i ferri tra le mani e lavorare nell’altra direzione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "針を持ち替えて、反対方向に編み戻る"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೈಗಳಲ್ಲಿ ಸೂಜಿಗಳನ್ನು ಬದಲಿಸಿ ಇನ್ನೊಂದು ದಿಕ್ಕಿನಲ್ಲಿ ಹಿಂದಕ್ಕೆ ಹೆಣೆಯಿರಿ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바늘을 양손에서 바꿔 반대 방향으로 되돌아 뜨기"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കൈകളിൽ സൂചികൾ മാറ്റി മറുദിശയിൽ തിരികെ തുന്നുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हातातील सुया बदला आणि दुसऱ्या दिशेने परत विणा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukar jarum antara tangan dan kerjakan semula ke arah yang lain"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytt pinnene mellom hendene og strikk tilbake i motsatt retning"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wissel de naalden van hand en brei de andere kant op terug"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ହାତରେ ଛୁଞ୍ଚି ବଦଳାନ୍ତୁ ଏବଂ ଅନ୍ୟ ଦିଗରେ ଫେରି ବୁଣନ୍ତୁ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹੱਥਾਂ ਵਿੱਚ ਸਲਾਈਆਂ ਬਦਲੋ ਅਤੇ ਦੂਜੀ ਦਿਸ਼ਾ ਵਿੱਚ ਵਾਪਸ ਬੁਣੋ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamienić druty w rękach i przerabiać w drugą stronę"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trocar as agulhas de mão e tricotar de volta no outro sentido"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Trocar as agulhas de mão e tricotar de volta no outro sentido"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimbă andrelele între mâini și lucrează înapoi în cealaltă direcție"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поменять спицы в руках и вязать обратно в другую сторону"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymeniť ihlice v rukách a plesť späť opačným smerom"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamenjaj igli v rokah in pleti nazaj v nasprotno smer"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byt sticka mellan händerna och arbeta tillbaka åt andra hållet"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
