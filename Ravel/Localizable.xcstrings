    "Slip 2 stitches knitwise one at a time, then knit them together through the back": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Passar 2 punts com per teixir-los, un a un, i després teixir-los junts per darrere"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přendat 2 oka jako na pletení, po jednom, a uplést je dohromady zezadu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Løft 2 masker som for at strikke dem, én ad gangen, og strik dem sammen bagfra"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2 Maschen einzeln rechts abheben, dann hinten verschränkt zusammenstricken"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasar 2 puntos como para tejer, uno a uno, y luego tejerlos juntos por detrás"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasar 2 puntos como para tejer, uno a uno, y luego tejerlos juntos por detrás"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirrä 2 silmukkaa oikein neuloen yksi kerrallaan, neulo ne sitten yhteen takaa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisser 2 mailles comme pour les tricoter à l’endroit, une par une, puis les tricoter ensemble par le brin arrière"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisser 2 mailles comme pour les tricoter à l’endroit, une par une, puis les tricoter ensemble par le brin arrière"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passare 2 maglie come per lavorarle a dritto, una alla volta, poi lavorarle insieme dietro"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Løft 2 masker som for å strikke dem, én om gangen, og strikk dem sammen bakfra"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "2 steken één voor één afhalen als voor rechts, en dan achter samenbreien"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjąć 2 oczka jak do przerabiania, po jednym, a potem przerobić je razem od tyłu"
          }
