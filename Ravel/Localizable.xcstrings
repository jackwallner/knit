    "Sewn over a finished knit stitch with a tapestry needle, following its two legs, so it looks knitted in": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُخاط فوق غرزة محبوكة منتهية بإبرة تطريز، متتبعةً ساقيها، فتبدو وكأنها محبوكة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্যাপেস্ট্রি সুচ দিয়ে শেষ হওয়া বোনা ঘরের দুই পায়া ধরে তার ওপর সেলাই করা হয়, যাতে মনে হয় বোনা হয়েছে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es cus sobre un punt de gènere acabat amb una agulla de llana, seguint les seves dues potes, perquè sembli teixit"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přišívá se přes hotové hladké oko jehlou na vlnu, po obou nitích oka, takže vypadá jako upletené"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sys over en færdig rettemaske med en stoppenål, langs dens to ben, så det ser strikket ud"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einer Wollnadel über eine fertige rechte Masche genäht, entlang ihrer beiden Schenkel, sodass es wie gestrickt aussieht"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ράβεται πάνω σε έναν ήδη πλεγμένο βρόχο με βελόνα ταπισερί, ακολουθώντας τα δύο σκέλη του, ώστε να μοιάζει πλεγμένος"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cose sobre un punto jersey ya tejido con una aguja lanera, siguiendo sus dos patas, para que parezca tejido"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cose sobre un punto jersey ya tejido con una aguja lanera, siguiendo sus dos patas, para que parezca tejido"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ommellaan valmiin oikean silmukan päälle villaneulalla sen kahta jalkaa seuraten, jolloin se näyttää neulotulta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cousu sur une maille endroit terminée avec une aiguille à laine, en suivant ses deux brins, pour qu'il paraisse tricoté"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cousu sur une maille endroit terminée avec une aiguille à laine, en suivant ses deux brins, pour qu'il paraisse tricoté"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ટેપેસ્ટ્રી સોયથી તૈયાર ગૂંથેલા ફંદા પર તેના બે પગને અનુસરીને સીવવામાં આવે છે, જેથી તે ગૂંથેલું લાગે"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נתפר מעל עין סריגה גמורה במחט שטיחים, לאורך שתי רגליה, כך שייראה סרוג"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेपेस्ट्री सुई से तैयार बुने फंदे के ऊपर उसकी दोनों टाँगों के साथ सिला जाता है, जिससे वह बुना हुआ दिखे"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prišiva se preko gotove lijeve petlje vunenom iglom, prateći njezine dvije noge, tako da izgleda kao isprleteno"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gobelintűvel öltik a kész sima szemre, a két szárát követve, így olyan, mintha kötötték volna"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijahit di atas jerat rajut yang sudah jadi dengan jarum tapestri, mengikuti kedua kakinya, sehingga tampak seperti dirajut"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cucito sopra una maglia rasata finita con un ago da lana, seguendone le due gambe, così sembra lavorato a maglia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "とじ針で、編み上がったメリヤス編みの目の2本の足に沿って刺し、編んだように見せます"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಟೇಪೆಸ್ಟ್ರಿ ಸೂಜಿಯಿಂದ ಮುಗಿದ ಹೆಣಿಗೆ ಹೊಲಿಗೆಯ ಎರಡು ಕಾಲುಗಳನ್ನು ಅನುಸರಿಸಿ ಅದರ ಮೇಲೆ ಹೊಲಿಯಲಾಗುತ್ತದೆ, ಆದ್ದರಿಂದ ಅದು ಹೆಣೆದಂತೆ ಕಾಣುತ್ತದೆ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완성된 겉뜨기 코 위에 돗바늘로 두 다리를 따라 꿰매어 떠서 만든 것처럼 보이게 해요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ടേപ്പസ്ട്രി സൂചി ഉപയോഗിച്ച് പൂർത്തിയായ കണ്ണിയുടെ രണ്ടു കാലുകളും പിന്തുടർന്ന് അതിനുമേൽ തുന്നുന്നു, അങ്ങനെ അത് നെയ്തതുപോലെ തോന്നും"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "टेपेस्ट्री सुईने तयार विणलेल्या टाक्यावर त्याच्या दोन पायांवरून शिवले जाते, म्हणजे ते विणल्यासारखे दिसते"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijahit di atas jerat rajutan yang siap dengan jarum tapestri, mengikut dua kakinya, supaya kelihatan seperti dirajut"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sys over en ferdig rettmaske med en stoppenål, langs de to bena, så det ser strikket ut"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met een stopnaald over een afgewerkte rechte steek genaaid, langs de twee benen, zodat het gebreid lijkt"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଟେପେଷ୍ଟ୍ରି ଛୁଞ୍ଚିରେ ସମ୍ପୂର୍ଣ୍ଣ ବୁଣା ଫାଶର ଦୁଇ ଗୋଡ଼କୁ ଅନୁସରଣ କରି ତା ଉପରେ ସିଲେଇ କରାଯାଏ, ଯାହାଫଳରେ ତାହା ବୁଣାଯାଇଥିବା ପରି ଦେଖାଯାଏ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਟੇਪੈਸਟਰੀ ਸੂਈ ਨਾਲ ਮੁਕੰਮਲ ਬੁਣੇ ਫੰਦੇ ਦੀਆਂ ਦੋਵੇਂ ਲੱਤਾਂ ਦੇ ਨਾਲ ਨਾਲ ਸਿਉਂਤਾ ਜਾਂਦਾ ਹੈ, ਤਾਂ ਜੋ ਇਹ ਬੁਣਿਆ ਹੋਇਆ ਲੱਗੇ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyszywany igłą włóczkową na gotowym oczku prawym, wzdłuż jego dwóch ramion, tak że wygląda jak zrobiony na drutach"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Costurado sobre um ponto meia já pronto com uma agulha de tapeçaria, seguindo suas duas pernas, para parecer tricotado"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Costurado sobre um ponto meia já pronto com uma agulha de tapeçaria, seguindo suas duas pernas, para parecer tricotado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se coase peste un ochi tricotat terminat cu un ac de tapiserie, urmând cele două picioare ale lui, ca să pară tricotat"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пришивается иглой поверх готовой лицевой петли по двум её ножкам, так что выглядит как вязаное"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prišíva sa cez hotové hladké očko ihlou na vlnu, po oboch jeho nitiach, takže to vyzerá ako upletené"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prišije se čez končano desno zanko z volneno iglo po njenih dveh nogicah, da je videti spleteno"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sys över en färdig rät maska med en stoppnål längs dess två ben, så det ser stickat ut"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "டேப்ஸ்ட்ரி ஊசியால் முடிந்த பின்னல் கண்ணியின் இரு கால்களையும் பின்பற்றி அதன் மேல் தைக்கப்படுகிறது, அதனால் அது பின்னியது போலத் தெரியும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "టేపెస్ట్రీ సూదితో పూర్తయిన అల్లిన కుట్టు రెండు కాళ్లను అనుసరించి దానిపై కుడతారు, అందువల్ల అది అల్లినట్లు కనిపిస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เย็บทับห่วงถักที่เสร็จแล้วด้วยเข็มสำหรับงานปัก ตามขาทั้งสองข้างของห่วง ให้ดูเหมือนถักมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitmiş bir düz ilmeğin üzerine, iki ayağını takip ederek kanaviçe iğnesiyle dikilir, böylece örülmüş gibi görünür"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пришивається голкою поверх готової лицьової петлі по двох її ніжках, тож виглядає як зв’язане"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹیپسٹری سوئی سے مکمل بنے ہوئے ٹانکے کی دونوں ٹانگوں کے ساتھ سیا جاتا ہے، تاکہ وہ بُنا ہوا لگے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng kim tapestry thêu đè lên mũi đan đã xong, theo hai chân của mũi, để trông như được đan sẵn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用毛线缝针沿已织好的下针的两条腿缝在上面，看起来像织出来的一样"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用毛線縫針沿已織好的下針的兩條腿縫在上面，看起來像織出來的一樣"
          }
        }
      }
    },
