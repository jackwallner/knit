    "Slip 2 stitches knitwise one at a time, then knit them together through the back": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقل غرزتين واحدة تلو الأخرى كما في الحياكة العادية، ثم احِكهما معًا من الخلف"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "২টি ঘর একটি একটি করে সোজা ঘরের মতো সরান, তারপর পিছন থেকে একসাথে বুনুন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Passar 2 punts com per teixir-los, un a un, i després teixir-los junts per darrere"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přendat 2 oka jako na pletení, po jednom, a uplést je dohromady zezadu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Løft 2 masker som for at strikke dem, én ad gangen, og strik dem sammen bagfra"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2 Maschen einzeln rechts abheben, dann hinten verschränkt zusammenstricken"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πέρασε 2 βρόχους ως για πλέξιμο, έναν έναν, και πλέξε τους μαζί από πίσω"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasar 2 puntos como para tejer, uno a uno, y luego tejerlos juntos por detrás"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasar 2 puntos como para tejer, uno a uno, y luego tejerlos juntos por detrás"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirrä 2 silmukkaa oikein neuloen yksi kerrallaan, neulo ne sitten yhteen takaa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisser 2 mailles comme pour les tricoter à l’endroit, une par une, puis les tricoter ensemble par le brin arrière"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisser 2 mailles comme pour les tricoter à l’endroit, une par une, puis les tricoter ensemble par le brin arrière"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "2 ફંદાને એક પછી એક સીધા ફંદાની જેમ ઉતારો, પછી પાછળથી સાથે ગૂંથો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העבר 2 עיניים בזו אחר זו כאילו לסרוג, ואז סרוג אותן יחד מאחור"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "2 फंदों को एक-एक करके सीधे फंदे की तरह उतारें, फिर पीछे से एक साथ बुनें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prebaciti 2 petlje kao za pletenje, jednu po jednu, pa ih splesti zajedno straga"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "2 szem áthúzása egyenként, mintha kötnéd, majd együtt kötésük hátulról"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser 2 jerat satu per satu seperti merajut, lalu rajut bersama dari belakang"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passare 2 maglie come per lavorarle a dritto, una alla volta, poi lavorarle insieme dietro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2目を1目ずつ表編みのように移し、後ろから一緒に編む"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "2 ಹೊಲಿಗೆಗಳನ್ನು ಒಂದೊಂದಾಗಿ ನೇರ ಹೊಲಿಗೆಯಂತೆ ಜಾರಿಸಿ, ನಂತರ ಹಿಂದಿನಿಂದ ಒಟ್ಟಿಗೆ ಹೆಣೆಯಿರಿ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2코를 겉뜨기 하듯 한 코씩 옮긴 뒤 뒤쪽으로 함께 뜨기"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "2 കണ്ണികൾ ഓരോന്നായി നേരെയുള്ള കണ്ണി പോലെ മാറ്റുക, പിന്നെ പിന്നിലൂടെ ഒരുമിച്ച് തുന്നുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "2 टाके एकेक करून सरळ टाक्यासारखे उतरवा, मग मागून एकत्र विणा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelongsorkan 2 jerat satu demi satu seperti merajut, kemudian rajut bersama dari belakang"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Løft 2 masker som for å strikke dem, én om gangen, og strikk dem sammen bakfra"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "2 steken één voor één afhalen als voor rechts, en dan achter samenbreien"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "2 ଫାଶକୁ ଗୋଟିଏ ଗୋଟିଏ କରି ସିଧା ଫାଶ ପରି ଓହ୍ଲାନ୍ତୁ, ତା'ପରେ ପଛରୁ ଏକାଠି ବୁଣନ୍ତୁ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "2 ਫੰਦੇ ਇੱਕ-ਇੱਕ ਕਰਕੇ ਸਿੱਧੇ ਫੰਦੇ ਵਾਂਗ ਉਤਾਰੋ, ਫਿਰ ਪਿੱਛੋਂ ਇਕੱਠੇ ਬੁਣੋ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjąć 2 oczka jak do przerabiania, po jednym, a potem przerobić je razem od tyłu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passar 2 pontos como para tricotar, um de cada vez, e depois tricotá-los juntos pela parte de trás"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Passar 2 pontos como para tricotar, um de cada vez, e depois tricotá-los juntos pela parte de trás"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alunecă 2 ochiuri ca pentru tricotat, pe rând, apoi tricotează-le împreună prin spate"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снять 2 петли по одной как для вязания лицевой, затем провязать их вместе за заднюю стенку"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prehodiť 2 očká ako na pletenie, po jednom, a upliesť ich dohromady zozadu"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenesi 2 zanki kot za pletenje, eno za drugo, nato ju spleti skupaj od zadaj"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyft 2 maskor som om de skulle stickas, en i taget, och sticka ihop dem bakifrån"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "2 கண்ணிகளை ஒவ்வொன்றாக நேர்க்கண்ணி போல் மாற்றி, பிறகு பின்புறமாக ஒன்றாகப் பின்னு"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "2 కుట్లను ఒక్కొక్కటిగా నేరు కుట్టులా మార్చి, వెనుక నుండి కలిపి అల్లండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลื่อน 2 ห่วงทีละห่วงเหมือนถักห่วงตรง แล้วถักรวมกันทางด้านหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2 ilmeği tek tek düz örer gibi kaydır, sonra arkadan birlikte ör"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зняти 2 петлі по одній як для лицьової, потім провʼязати їх разом за задню стінку"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "2 ٹانکے ایک ایک کر کے سیدھے ٹانکے کی طرح منتقل کریں، پھر انہیں پیچھے سے ایک ساتھ بنیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trượt từng mũi trong 2 mũi như đan mũi xuôi, rồi đan chúng cùng nhau từ phía sau"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 2 针依次像织下针一样移过，再从后面一起织"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 2 針依序像織下針一樣移過，再從後面一起織"
          }
        }
      }
    },
