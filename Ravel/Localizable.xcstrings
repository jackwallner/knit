    "Renews until you cancel in Settings. A pattern you cast on is yours to keep.": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es renova fins que cancel·lis a Configuració. Un patró que hagis començat és teu per sempre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovuje se, dokud ho nezrušíte v Nastavení. Návod, který jste začali plést, vám zůstane."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornyes, indtil du opsiger i Indstillinger. En opskrift, du er gået i gang med, er din at beholde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlängert sich, bis du in den Einstellungen kündigst. Ein Muster, das du angeschlagen hast, bleibt dir erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva hasta que canceles en Ajustes. Un patrón que hayas empezado es tuyo para siempre."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva hasta que canceles en Ajustes. Un patrón que hayas empezado es tuyo para siempre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uusiutuu, kunnes perut asetuksissa. Aloittamasi ohje pysyy sinulla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renouvelle jusqu’à ce que vous résiliez dans Réglages. Un modèle que vous avez commencé reste à vous."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renouvelle jusqu’à ce que vous résiliez dans Réglages. Un modèle que vous avez commencé reste à vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rinnova finché non annulli in Impostazioni. Uno schema che hai avviato resta tuo."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornyes til du sier opp i Innstillinger. En oppskrift du har startet på er din å beholde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt verlengd tot je opzegt in Instellingen. Een patroon dat je hebt opgezet blijft van jou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odnawia się, dopóki nie anulujesz w Ustawieniach. Rozpoczęty wzór zostaje Twój."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renova até você cancelar em Ajustes. Uma receita que você começou é sua para sempre."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Renova até cancelares em Definições. Um padrão que tenhas começado é teu para sempre."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovuje sa, kým ho nezrušíte v Nastaveniach. Návod, ktorý ste začali plesť, vám zostane."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förnyas tills du avbryter i Inställningar. Ett mönster du har lagt upp är ditt att behålla."
          }
        }
      }
    },
