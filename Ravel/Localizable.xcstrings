        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तुळ बंद करण्यासाठी पहिला घातलेला टाका कामाच्या धाग्याने विणा, घालण्याची किनार सुईभोवती सपाट राहू द्या, पिळलेली नको"
