    "The App Store could not be reached. Try again when you are online.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى App Store. حاول مرة أخرى عند الاتصال بالإنترنت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store-এ পৌঁছানো যায়নি। অনলাইনে এলে আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha pogut accedir a l’App Store. Torna-ho a provar quan siguis en línia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store není dostupný. Zkuste to znovu, až budete online."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store kunne ikke nås. Prøv igen, når du er online."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store ist nicht erreichbar. Versuche es erneut, wenn du online bist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η σύνδεση με το App Store. Δοκίμασε ξανά όταν είσαι online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con la App Store. Inténtalo de nuevo cuando tengas conexión."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con la App Store. Inténtalo de nuevo cuando tengas conexión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeen ei saatu yhteyttä. Yritä uudelleen, kun olet verkossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store est inaccessible. Réessayez une fois en ligne."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store est inaccessible. Réessayez une fois en ligne."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store સુધી પહોંચી શકાયું નહીં. ઑનલાઇન થાઓ ત્યારે ફરી પ્રયાસ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להתחבר ל-App Store. נסה שוב כשתהיה מחובר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store तक नहीं पहुँचा जा सका। ऑनलाइन होने पर फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store nije dostupan. Pokušajte ponovno kad budete online."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az App Store nem érhető el. Próbáld újra, ha online vagy."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store tidak dapat dijangkau. Coba lagi saat Anda online."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere l’App Store. Riprova quando sei online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeに接続できませんでした。オンラインになってからもう一度お試しください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store ಅನ್ನು ತಲುಪಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಆನ್‌ಲೈನ್ ಆದಾಗ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에 연결할 수 없어요. 온라인 상태에서 다시 시도해 주세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store-ൽ എത്താനായില്ല. ഓൺലൈനിൽ ആയ ശേഷം വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store शी संपर्क होऊ शकला नाही. ऑनलाइन झाल्यावर पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store tidak dapat dihubungi. Cuba lagi apabila anda dalam talian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fikk ikke kontakt med App Store. Prøv igjen når du er på nett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De App Store is niet bereikbaar. Probeer het opnieuw als je online bent."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store ସହ ସଂଯୋଗ ହୋଇପାରିଲା ନାହିଁ। ଅନଲାଇନ୍ ହେଲେ ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store ਤੱਕ ਪਹੁੰਚ ਨਹੀਂ ਹੋ ਸਕੀ। ਆਨਲਾਈਨ ਹੋਣ ਉੱਤੇ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można połączyć się z App Store. Spróbuj ponownie, gdy będziesz online."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar a App Store. Tente de novo quando estiver online."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ligar à App Store. Tenta novamente quando estiveres online."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store nu a putut fi contactat. Încearcă din nou când ești online."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с App Store. Повторите, когда будете онлайн."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store nie je dostupný. Skúste to znova, keď budete online."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store ni dosegljiv. Poskusite znova, ko boste na spletu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store gick inte att nå. Försök igen när du är online."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store-ஐ அணுக முடியவில்லை. ஆன்லைனில் இருக்கும்போது மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store ను చేరుకోలేకపోయాం. ఆన్‌లైన్‌లో ఉన్నప్పుడు మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อ App Store ไม่ได้ ลองใหม่เมื่อออนไลน์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store'a ulaşılamadı. Çevrimiçi olduğunuzda tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зв’язатися з App Store. Спробуйте ще раз, коли будете онлайн."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store تک رسائی نہیں ہو سکی۔ آن لائن ہونے پر دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không kết nối được App Store. Hãy thử lại khi có mạng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 App Store。请在联网后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線至 App Store。請在連上網路後重試。"
          }
        }
      }
    },
