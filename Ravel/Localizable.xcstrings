            "value": "P1, M1P، احِك مقلوبًا حتى غرزة واحدة قبل العلامة التالية، M1P، p1، انقل العلامة. تُضيف غرزتين"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, পরের মার্কারের ১টি ঘর আগে পর্যন্ত উল্টো বুনুন, M1P, p1, মার্কার সরান। এটি ২টি ঘর বাড়ায়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, teixir del revés fins a 1 punt abans del marcador següent, M1P, p1, passar el marcador. Afegeix 2 punts"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, plést obráceně do 1 oka před další značkou, M1P, p1, přendat značku. Přidá 2 oka"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, strik vrang til 1 maske før næste markør, M1P, p1, løft markøren. Det tager 2 masker til"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, links stricken bis 1 Masche vor dem nächsten Markierer, M1P, p1, Markierer abheben. Es nimmt 2 Maschen zu"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, πλέξε ανάποδα μέχρι 1 βρόχο πριν τον επόμενο δείκτη, M1P, p1, πέρασε τον δείκτη. Προσθέτει 2 βρόχους"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, tejer del revés hasta 1 punto antes del siguiente marcador, M1P, p1, pasar el marcador. Añade 2 puntos"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, tejer del revés hasta 1 punto antes del siguiente marcador, M1P, p1, pasar el marcador. Añade 2 puntos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, neulo nurin 1 silmukka ennen seuraavaa merkkiä, M1P, p1, siirrä merkki. Se lisää 2 silmukkaa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, tricoter à l’envers jusqu’à 1 maille avant le prochain marqueur, M1P, p1, glisser le marqueur. Cela ajoute 2 mailles"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, tricoter à l’envers jusqu’à 1 maille avant le prochain marqueur, M1P, p1, glisser le marqueur. Cela ajoute 2 mailles"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, આગલા માર્કરથી 1 ફંદો પહેલાં સુધી ઊંધા ગૂંથો, M1P, p1, માર્કર ખસેડો. તે 2 ફંદા ઉમેરે છે"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, סרוג הפוך עד עין אחת לפני הסמן הבא, M1P, p1, העבר את הסמן. מוסיף 2 עיניים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, अगले मार्कर से 1 फंदा पहले तक उल्टा बुनें, M1P, p1, मार्कर खिसकाएँ। यह 2 फंदे बढ़ाता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, plesti lijevo do 1 petlje prije sljedeće oznake, M1P, p1, prebaciti oznaku. Dodaje 2 petlje"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, fordított kötés a következő jelölő előtti 1 szemig, M1P, p1, a jelölő áthúzása. 2 szemet szaporít"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, purl sampai 1 jerat sebelum penanda berikutnya, M1P, p1, geser penanda. Menambah 2 jerat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, lavorare a rovescio fino a 1 maglia prima del segnapunti successivo, M1P, p1, passare il segnapunti. Aggiunge 2 maglie"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "P1、M1P、次のマーカーの1目手前まで裏編みし、M1P、p1、マーカーを移す。2目増える"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, ಮುಂದಿನ ಮಾರ್ಕರ್‌ಗಿಂತ 1 ಹೊಲಿಗೆ ಮೊದಲಿನವರೆಗೆ ಹಿಮ್ಮುಖವಾಗಿ ಹೆಣೆಯಿರಿ, M1P, p1, ಮಾರ್ಕರ್ ಜಾರಿಸಿ. ಇದು 2 ಹೊಲಿಗೆಗಳನ್ನು ಸೇರಿಸುತ್ತದೆ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, 다음 마커 1코 앞까지 안뜨고, M1P, p1, 마커 옮기기. 2코가 늘어남"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, അടുത്ത മാർക്കറിന് 1 കണ്ണി മുമ്പ് വരെ തിരിച്ചു തുന്നുക, M1P, p1, മാർക്കർ മാറ്റുക. ഇത് 2 കണ്ണി കൂട്ടുന്നു"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, पुढच्या मार्करच्या 1 टाका आधीपर्यंत उलटे विणा, M1P, p1, मार्कर सरकवा. हे 2 टाके वाढवते"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, purl sehingga 1 jerat sebelum penanda seterusnya, M1P, p1, gelongsorkan penanda. Menambah 2 jerat"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, strikk vrang til 1 maske før neste markør, M1P, p1, løft markøren. Det øker med 2 masker"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, averechts breien tot 1 steek voor de volgende markeerder, M1P, p1, haal de markeerder af. Het voegt 2 steken toe"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, ପରବର୍ତ୍ତୀ ମାର୍କରର 1 ଫାଶ ପୂର୍ବ ପର୍ଯ୍ୟନ୍ତ ଓଲଟା ବୁଣନ୍ତୁ, M1P, p1, ମାର୍କର ସରକାନ୍ତୁ। ଏହା 2 ଫାଶ ଯୋଡ଼େ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, ਅਗਲੇ ਮਾਰਕਰ ਤੋਂ 1 ਫੰਦਾ ਪਹਿਲਾਂ ਤੱਕ ਪੁੱਠਾ ਬੁਣੋ, M1P, p1, ਮਾਰਕਰ ਖਿਸਕਾਓ। ਇਹ 2 ਫੰਦੇ ਜੋੜਦਾ ਹੈ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, przerabiać na lewo do 1 oczka przed następnym markerem, M1P, p1, przełożyć marker. Dodaje 2 oczka"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, tricotar no avesso até 1 ponto antes do próximo marcador, M1P, p1, passar o marcador. Aumenta 2 pontos"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, tricotar no avesso até 1 ponto antes do próximo marcador, M1P, p1, passar o marcador. Aumenta 2 pontos"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, tricotează de dos până la 1 ochi înainte de următorul marcaj, M1P, p1, alunecă marcajul. Adaugă 2 ochiuri"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, вязать изнаночными до 1 петли перед следующим маркером, M1P, p1, переложить маркер. Прибавляет 2 петли"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, plesť obrátene do 1 očka pred ďalšou značkou, M1P, p1, prehodiť značku. Pridá 2 očká"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, pleti levo do 1 zanke pred naslednjim označevalcem, M1P, p1, prestavi označevalec. Doda 2 zanki"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, sticka avigt till 1 maska före nästa markör, M1P, p1, lyft markören. Det ökar 2 maskor"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, அடுத்த குறிப்பானுக்கு 1 கண்ணி முன்பு வரை தலைகீழாகப் பின்னு, M1P, p1, குறிப்பானை நகர்த்து. இது 2 கண்ணிகளைக் கூட்டுகிறது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, తదుపరి మార్కర్‌కు 1 కుట్టు ముందు వరకు తిరగబడ్డవిగా అల్లండి, M1P, p1, మార్కర్‌ను జరపండి. ఇది 2 కుట్లను కలుపుతుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, ถักห่วงกลับไปจนเหลือ 1 ห่วงก่อนตัวมาร์กเกอร์ถัดไป, M1P, p1, เลื่อนมาร์กเกอร์ เพิ่ม 2 ห่วง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, sonraki işaretçiden 1 ilmek önceye kadar ters ör, M1P, p1, işaretçiyi kaydır. 2 ilmek ekler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, в’язати виворітними до 1 петлі перед наступним маркером, M1P, p1, перекласти маркер. Додає 2 петлі"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "P1، M1P، اگلے نشان سے 1 ٹانکا پہلے تک الٹا بنیں، M1P، p1، نشان منتقل کریں۔ یہ 2 ٹانکے بڑھاتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "P1, M1P, đan ngược đến còn 1 mũi trước dấu đánh dấu tiếp theo, M1P, p1, trượt dấu đánh dấu. Tăng thêm 2 mũi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "P1、M1P，织上针到下一个记号圈前 1 针，M1P、p1，移过记号圈。共加 2 针"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "P1、M1P，織上針到下一個記號圈前 1 針，M1P、p1，移過記號圈。共加 2 針"
          }
        }
      }
    },
