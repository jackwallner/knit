        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer les aiguilles de main et tricoter en sens inverse"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scambiare i ferri tra le mani e lavorare nell’altra direzione"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytt pinnene mellom hendene og strikk tilbake i motsatt retning"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wissel de naalden van hand en brei de andere kant op terug"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamienić druty w rękach i przerabiać w drugą stronę"
          }
        },
        "pt-BR": {
          "stringUnit": {
