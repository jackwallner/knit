    "Make 1 left: lift the bar from the front and knit it through the back": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Masche links geneigt zunehmen: den Querfaden von vorn aufnehmen und hinten verschränkt rechts stricken"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumento de 1 a la izquierda: levantar la hebra desde delante y tejerla por detrás"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumento de 1 a la izquierda: levantar la hebra desde delante y tejerla por detrás"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmentation de 1 à gauche : relever le fil par l’avant et le tricoter par le brin arrière"
          }
