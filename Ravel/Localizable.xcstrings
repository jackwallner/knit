    "They are still on this %@. Restart it, then open Ravel again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زالت موجودة على هذا الـ%@. أعد تشغيله ثم افتح Ravel مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেগুলো এখনও এই %@-এ আছে। এটি রিস্টার্ট করে আবার Ravel খুলুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara són en aquest %@. Reinicia’l i torna a obrir Ravel."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stále jsou na tomto zařízení (%@). Restartujte ho a znovu otevřete Ravel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De findes stadig på denne %@. Genstart den, og åbn Ravel igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sind noch auf diesem %@. Starte es neu und öffne Ravel dann erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρίσκονται ακόμη σε αυτό το %@. Κάνε επανεκκίνηση και άνοιξε ξανά το Ravel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siguen en este %@. Reinícialo y vuelve a abrir Ravel."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Siguen en este %@. Reinícialo y vuelve a abrir Ravel."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne ovat yhä tässä laitteessa (%@). Käynnistä se uudelleen ja avaa Ravel uudestaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils sont toujours sur cet %@. Redémarrez-le, puis rouvrez Ravel."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils sont toujours sur cet %@. Redémarrez-le, puis rouvrez Ravel."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તે હજી આ %@ પર છે. તેને ફરી શરૂ કરો, પછી Ravel ફરી ખોલો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הם עדיין נמצאים ב-%@ הזה. הפעל אותו מחדש ופתח את Ravel שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वे अभी भी इस %@ पर हैं। इसे रीस्टार्ट करें, फिर Ravel दोबारा खोलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "I dalje su na ovom uređaju (%@). Ponovno ga pokrenite i otvorite Ravel."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még mindig ezen az eszközön vannak (%@). Indítsd újra, majd nyisd meg újra a Ravelt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proyek masih ada di %@ ini. Mulai ulang lalu buka Ravel lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono ancora su questo %@. Riavvialo, poi riapri Ravel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データはこの%@に残っています。再起動してからRavelをもう一度開いてください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅವು ಇನ್ನೂ ಈ %@ ನಲ್ಲಿವೆ. ಇದನ್ನು ಮರುಪ್ರಾರಂಭಿಸಿ, ನಂತರ Ravel ಅನ್ನು ಮತ್ತೆ ತೆರೆಯಿರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트는 아직 이 %@에 있어요. 다시 시작한 뒤 Ravel을 다시 열어 주세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അവ ഇപ്പോഴും ഈ %@-ൽ ഉണ്ട്. ഇത് റീസ്റ്റാർട്ട് ചെയ്ത ശേഷം Ravel വീണ്ടും തുറക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ते अजूनही या %@ वर आहेत. ते रीस्टार्ट करा, मग Ravel पुन्हा उघडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Projek masih ada pada %@ ini. Mulakan semula, kemudian buka Ravel sekali lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De ligger fortsatt på denne %@. Start den på nytt og åpne Ravel igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze staan nog op deze %@. Start hem opnieuw op en open Ravel dan opnieuw."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସେଗୁଡ଼ିକ ଏବେ ବି ଏହି %@ ରେ ଅଛି। ଏହାକୁ ପୁଣି ଚାଲୁ କରନ୍ତୁ, ତା'ପରେ Ravel ପୁଣି ଖୋଲନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉਹ ਹਾਲੇ ਵੀ ਇਸ %@ ਉੱਤੇ ਹਨ। ਇਸਨੂੰ ਮੁੜ ਚਾਲੂ ਕਰੋ, ਫਿਰ Ravel ਦੁਬਾਰਾ ਖੋਲ੍ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadal są na tym urządzeniu (%@). Uruchom je ponownie i otwórz Ravel jeszcze raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles continuam neste %@. Reinicie-o e abra o Ravel de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuam neste %@. Reinicia-o e abre o Ravel de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunt încă pe acest %@. Repornește-l și deschide din nou Ravel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они по-прежнему на этом устройстве (%@). Перезапустите его и снова откройте Ravel."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stále sú na tomto zariadení (%@). Reštartujte ho a znova otvorte Ravel."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Še vedno so v tej napravi (%@). Znova jo zaženite in ponovno odprite Ravel."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De finns kvar på den här %@. Starta om den och öppna Ravel igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அவை இன்னும் இந்த %@ இல் உள்ளன. இதை மறுதொடக்கம் செய்து Ravel-ஐ மீண்டும் திறக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అవి ఇంకా ఈ %@ లో ఉన్నాయి. దీన్ని రీస్టార్ట్ చేసి, Ravel ను మళ్లీ తెరవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรเจกต์ยังอยู่บน%@เครื่องนี้ รีสตาร์ตแล้วเปิด Ravel อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hâlâ bu %@ cihazında duruyorlar. Yeniden başlatın ve Ravel'i tekrar açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вони досі на цьому пристрої (%@). Перезапустіть його й знову відкрийте Ravel."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ اب بھی اس %@ پر ہیں۔ اسے دوبارہ شروع کریں، پھر Ravel دوبارہ کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng vẫn nằm trên %@ này. Hãy khởi động lại rồi mở Ravel lần nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它们仍在这台%@上。请重新启动后再打开 Ravel。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它們仍在這部%@上。請重新啟動後再開啟 Ravel。"
          }
        }
      }
    },
