        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ Apple ಖಾತೆಯಲ್ಲಿ ಯಾವುದೇ ಖರೀದಿ ಕಂಡುಬಂದಿಲ್ಲ"
