    "Slip 1 knitwise, knit 2 together, then pass the slipped stitch over. It takes away 2 stitches": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقل غرزة واحدة كما في الحياكة العادية، احِك غرزتين معًا، ثم مرّر الغرزة المنقولة فوقهما. تُنقص غرزتين"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "১টি ঘর সোজার মতো সরান, ২টি ঘর একসাথে বুনুন, তারপর সরানো ঘরটি তার ওপর দিয়ে টেনে নিন। এতে ২টি ঘর কমে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Passar 1 punt com per teixir-lo, teixir 2 punts junts i passar-hi per sobre el punt passat. Treu 2 punts"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přendat 1 oko jako na pletení, uplést 2 oka dohromady a přetáhnout přes ně přendané oko. Ubere 2 oka"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Løft 1 maske som for at strikke ret, strik 2 masker sammen, og træk den løftede maske over. Den tager 2 masker væk"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Masche rechts abheben, 2 Maschen zusammenstricken und die abgehobene Masche darüberziehen. Es nimmt 2 Maschen ab"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πέρασε 1 βρόχο ως για πλέξιμο, πλέξε 2 βρόχους μαζί και πέρασε από πάνω τον βρόχο που πέρασες. Αφαιρεί 2 βρόχους"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasar 1 punto como para tejer, tejer 2 puntos juntos y pasar el punto pasado por encima. Quita 2 puntos"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasar 1 punto como para tejer, tejer 2 puntos juntos y pasar el punto pasado por encima. Quita 2 puntos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirrä 1 silmukka oikein neuloen, neulo 2 silmukkaa yhteen ja vedä siirretty silmukka niiden yli. Se vähentää 2 silmukkaa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisser 1 maille comme pour la tricoter à l’endroit, tricoter 2 mailles ensemble, puis passer la maille glissée par-dessus. Cela enlève 2 mailles"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisser 1 maille comme pour la tricoter à l’endroit, tricoter 2 mailles ensemble, puis passer la maille glissée par-dessus. Cela enlève 2 mailles"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ફંદો સીધાની જેમ ઉતારો, 2 ફંદા સાથે ગૂંથો, પછી ઉતારેલો ફંદો તેની ઉપરથી ઉતારો. તે 2 ફંદા ઘટાડે છે"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העבר עין אחת כאילו לסרוג, סרוג 2 עיניים יחד, ואז משוך את העין שהועברה מעליהן. זה מפחית 2 עיניים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1 फंदा सीधे की तरह उतारें, 2 फंदे एक साथ बुनें, फिर उतारे हुए फंदे को उन पर से निकाल दें। यह 2 फंदे घटाता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prebaciti 1 petlju kao za pletenje, splesti 2 petlje zajedno, pa prebačenu petlju prevući preko njih. Smanjuje za 2 petlje"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "1 szem áthúzása, mintha kötnéd, 2 szem együtt kötése, majd az áthúzott szem áthúzása rajtuk. 2 szemet fogyaszt"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser 1 jerat seperti merajut, rajut 2 jerat bersama, lalu tarik jerat yang digeser melewatinya. Mengurangi 2 jerat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passare 1 maglia come per lavorarla a dritto, lavorare 2 maglie insieme a dritto, poi accavallare la maglia passata. Toglie 2 maglie"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1目を表編みのように移し、2目一度に編み、移した目をかぶせる。2目減る"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ಹೊಲಿಗೆಯನ್ನು ನೇರದಂತೆ ಜಾರಿಸಿ, 2 ಹೊಲಿಗೆ ಒಟ್ಟಿಗೆ ಹೆಣೆಯಿರಿ, ನಂತರ ಜಾರಿಸಿದ ಹೊಲಿಗೆಯನ್ನು ಅವುಗಳ ಮೇಲೆ ಎಳೆಯಿರಿ. ಇದು 2 ಹೊಲಿಗೆ ಕಡಿಮೆ ಮಾಡುತ್ತದೆ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1코를 겉뜨기 하듯 옮기고, 2코 모아뜨기를 한 뒤 옮긴 코를 덮어씌우기. 2코가 줄어든다"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "1 കണ്ണി നേരെയുള്ളത് പോലെ മാറ്റുക, 2 കണ്ണികൾ ഒരുമിച്ച് തുന്നുക, പിന്നെ മാറ്റിയ കണ്ണി അവയ്ക്ക് മുകളിലൂടെ വലിക്കുക. ഇത് 2 കണ്ണി കുറയ്ക്കുന്നു"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 टाका सरळ टाक्यासारखा उतरवा, 2 टाके एकत्र विणा, मग उतरवलेला टाका त्यांवरून ओढा. यामुळे 2 टाके कमी होतात"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelongsorkan 1 jerat seperti merajut, rajut 2 jerat bersama, kemudian lalukan jerat yang digelongsorkan ke atasnya. Ia mengurangkan 2 jerat"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Løft 1 maske som for å strikke rett, strikk 2 masker sammen, og dra den løftede masken over. Den tar bort 2 masker"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1 steek afhalen als voor rechts, 2 steken samenbreien en de afgehaalde steek erover halen. Het neemt 2 steken af"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ଫାଶ ସିଧା ପରି ଓହ୍ଲାନ୍ତୁ, 2 ଫାଶ ଏକାଠି ବୁଣନ୍ତୁ, ତା'ପରେ ଓହ୍ଲାଇଥିବା ଫାଶକୁ ସେଗୁଡ଼ିକ ଉପରେ ଟାଣି ନିଅନ୍ତୁ। ଏହା 2 ଫାଶ କମାଏ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ਫੰਦਾ ਸਿੱਧੇ ਵਾਂਗ ਉਤਾਰੋ, 2 ਫੰਦੇ ਇਕੱਠੇ ਬੁਣੋ, ਫਿਰ ਉਤਾਰਿਆ ਫੰਦਾ ਉਨ੍ਹਾਂ ਉੱਪਰੋਂ ਲੰਘਾ ਦਿਓ। ਇਹ 2 ਫੰਦੇ ਘਟਾਉਂਦਾ ਹੈ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjąć 1 oczko jak do przerabiania, przerobić 2 oczka razem i przeciągnąć zdjęte oczko przez nie. Zmniejsza o 2 oczka"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passar 1 ponto como para tricotar, tricotar 2 pontos juntos e passar o ponto passado por cima. Tira 2 pontos"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Passar 1 ponto como para tricotar, tricotar 2 pontos juntos e passar o ponto passado por cima. Tira 2 pontos"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alunecă 1 ochi ca pentru tricotat, tricotează 2 ochiuri împreună, apoi trage ochiul alunecat peste ele. Scade 2 ochiuri"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снять 1 петлю как для лицевой, провязать 2 петли вместе и протянуть через них снятую петлю. Убавляет 2 петли"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prehodiť 1 očko ako na pletenie, upliesť 2 očká dohromady a prehodené očko pretiahnuť cez ne. Ubudnú 2 očká"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenesi 1 zanko kot za pletenje, spleti 2 zanki skupaj in prenesi zanko čez njiju. Odvzame 2 zanki"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyft 1 maska som om den skulle stickas rät, sticka 2 maskor ihop och dra den lyfta maskan över. Den tar bort 2 maskor"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "1 கண்ணியை நேர்க்கண்ணி போல் மாற்று, 2 கண்ணிகளை ஒன்றாகப் பின்னு, பிறகு மாற்றிய கண்ணியை அவற்றின் மேல் இழு. இது 2 கண்ணிகளைக் குறைக்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "1 కుట్టును నేరు కుట్టులా మార్చండి, 2 కుట్లను కలిపి అల్లండి, తర్వాత మార్చిన కుట్టును వాటిపైకి లాగండి. ఇది 2 కుట్లను తగ్గిస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลื่อน 1 ห่วงเหมือนถักห่วงตรง ถัก 2 ห่วงรวมกัน แล้วยกห่วงที่เลื่อนไว้คลุมข้ามไป ลดลง 2 ห่วง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ilmeği düz örer gibi kaydır, 2 ilmeği birlikte ör, sonra kaydırdığın ilmeği üzerlerinden geçir. 2 ilmek azaltır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зняти 1 петлю як для лицьової, провʼязати 2 петлі разом і протягнути через них зняту петлю. Зменшує на 2 петлі"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ٹانکا سیدھے کی طرح منتقل کریں، 2 ٹانکے ایک ساتھ بنیں، پھر منتقل کیا ہوا ٹانکا ان کے اوپر سے گزار دیں۔ یہ 2 ٹانکے کم کرتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trượt 1 mũi như đan mũi xuôi, đan 2 mũi cùng nhau, rồi kéo mũi đã trượt trùm qua. Bớt 2 mũi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 1 针像织下针一样移过，2 针并为一针，再把移过的针目盖过去。减少 2 针"
          }
