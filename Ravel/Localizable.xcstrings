    "K1, M1L, knit to 1 stitch before the next marker, M1R, k1, slip the marker. It adds 2 stitches": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "K1, M1L, teixir fins a 1 punt abans del marcador següent, M1R, k1, passar el marcador. Afegeix 2 punts"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K1, M1L, plést do 1 oka před další značkou, M1R, k1, přendat značku. Přidá 2 oka"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "K1, M1L, strik til 1 maske før næste markør, M1R, k1, løft markøren. Det tager 2 masker til"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "K1, M1L, rechts stricken bis 1 Masche vor dem nächsten Markierer, M1R, k1, Markierer abheben. Es nimmt 2 Maschen zu"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "K1, M1L, tejer hasta 1 punto antes del siguiente marcador, M1R, k1, pasar el marcador. Añade 2 puntos"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "K1, M1L, tejer hasta 1 punto antes del siguiente marcador, M1R, k1, pasar el marcador. Añade 2 puntos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "K1, M1L, neulo 1 silmukka ennen seuraavaa merkkiä, M1R, k1, siirrä merkki. Se lisää 2 silmukkaa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "K1, M1L, tricoter jusqu’à 1 maille avant le prochain marqueur, M1R, k1, glisser le marqueur. Cela ajoute 2 mailles"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "K1, M1L, tricoter jusqu’à 1 maille avant le prochain marqueur, M1R, k1, glisser le marqueur. Cela ajoute 2 mailles"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "K1, M1L, lavorare fino a 1 maglia prima del segnapunti successivo, M1R, k1, passare il segnapunti. Aggiunge 2 maglie"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "K1, M1L, strikk til 1 maske før neste markør, M1R, k1, løft markøren. Det øker med 2 masker"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "K1, M1L, brei tot 1 steek voor de volgende markeerder, M1R, k1, haal de markeerder af. Het voegt 2 steken toe"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "K1, M1L, przerabiać do 1 oczka przed następnym markerem, M1R, k1, przełożyć marker. Dodaje 2 oczka"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "K1, M1L, tricotar até 1 ponto antes do próximo marcador, M1R, k1, passar o marcador. Aumenta 2 pontos"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "K1, M1L, tricotar até 1 ponto antes do próximo marcador, M1R, k1, passar o marcador. Aumenta 2 pontos"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "K1, M1L, plesť do 1 očka pred ďalšou značkou, M1R, k1, prehodiť značku. Pridá 2 očká"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "K1, M1L, sticka till 1 maska före nästa markör, M1R, k1, lyft markören. Det ökar 2 maskor"
          }
        }
      }
    },
