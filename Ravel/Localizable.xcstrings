          "stringUnit": {
            "state": "translated",
            "value": "Skift pindene mellem hænderne og strik tilbage i den modsatte retning"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nadeln in den Händen tauschen und in die andere Richtung zurückstricken"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar las agujas de mano y tejer de vuelta en el otro sentido"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar las agujas de mano y tejer de vuelta en el otro sentido"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda puikot käsien välillä ja neulo takaisin toiseen suuntaan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer les aiguilles de main et tricoter en sens inverse"
