    "Push the needle through the edge of the fabric, wrap the yarn and pull a loop through. Each loop is 1 stitch": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Passar l’agulla per la vora de la peça, envoltar el fil i treure un llaç. Cada llaç és 1 punt"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Protáhnout jehlici okrajem práce, ovinout nit a protáhnout smyčku. Každá smyčka je 1 oko"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stik pinden gennem kanten af arbejdet, læg tråden om, og træk en løkke igennem. Hver løkke er 1 maske"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nadel durch den Stoffrand stechen, den Faden umschlagen und eine Schlinge durchziehen. Jede Schlinge ist 1 Masche"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasar la aguja por el borde de la labor, rodear con la hebra y sacar un lazo. Cada lazo es 1 punto"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasar la aguja por el borde de la labor, rodear con la hebra y sacar un lazo. Cada lazo es 1 punto"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pujota puikko työn reunan läpi, kierrä lanka ja vedä silmukka läpi. Jokainen silmukka on 1 silmukka"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer l’aiguille dans le bord de l’ouvrage, enrouler le fil et tirer une boucle. Chaque boucle compte pour 1 maille"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer l’aiguille dans le bord de l’ouvrage, enrouler le fil et tirer une boucle. Chaque boucle compte pour 1 maille"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Infilare il ferro nel bordo del lavoro, avvolgere il filo e tirare fuori un anello. Ogni anello è 1 maglia"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stikk pinnen gjennom kanten på arbeidet, legg tråden rundt og trekk opp en løkke. Hver løkke er 1 maske"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Steek de naald door de rand van het werk, sla de draad om en trek een lus door. Elke lus is 1 steek"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wsunąć drut w brzeg robótki, owinąć nitkę i przeciągnąć pętlę. Każda pętla to 1 oczko"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passar a agulha pela borda do tecido, envolver o fio e puxar uma laçada. Cada laçada é 1 ponto"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Passar a agulha pela borda do tecido, envolver o fio e puxar uma laçada. Cada laçada é 1 ponto"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevliecť ihlicu okrajom práce, ovinúť niť a pretiahnuť slučku. Každá slučka je 1 očko"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För stickan genom kanten på arbetet, lägg tråden om och dra igenom en ögla. Varje ögla är 1 maska"
          }
        }
      }
