        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି Apple ଆକାଉଣ୍ଟ ଏହାର ମାଗଣା ସପ୍ତାହ ପୂର୍ବରୁ ବ୍ୟବହାର କରିସାରିଛି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ Apple ਖਾਤੇ ਨੇ ਆਪਣਾ ਮੁਫ਼ਤ ਹਫ਼ਤਾ ਪਹਿਲਾਂ ਹੀ ਵਰਤ ਲਿਆ ਹੈ।"
