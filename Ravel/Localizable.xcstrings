    "Twist a loop of the working yarn and slide it onto the right needle. Each loop is 1 stitch": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجدل حلقة من خيط العمل وأزلقها على الإبرة اليمنى. كل حلقة تساوي غرزة واحدة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাজের সুতো দিয়ে একটি ফাঁস পাকান এবং ডান কাঁটায় সরান। প্রতিটি ফাঁস ১টি ঘর"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Torçar un llaç del fil de treball i lliscar-lo a l’agulla dreta. Cada llaç és 1 punt"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stočit smyčku z pracovní nitě a posunout ji na pravou jehlici. Každá smyčka je 1 oko"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sno en løkke af arbejdstråden, og skub den over på højre pind. Hver løkke er 1 maske"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Schlinge aus dem Arbeitsfaden drehen und auf die rechte Nadel schieben. Jede Schlinge ist 1 Masche"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στρίψε έναν βρόχο από το νήμα εργασίας και σύρε τον στη δεξιά βελόνα. Κάθε βρόχος είναι 1 βρόχος"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retorcer un lazo de la hebra de trabajo y deslizarlo a la aguja derecha. Cada lazo es 1 punto"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Retorcer un lazo de la hebra de trabajo y deslizarlo a la aguja derecha. Cada lazo es 1 punto"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kierrä työlangasta silmukka ja liu’uta se oikealle puikolle. Jokainen silmukka on 1 silmukka"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tordre une boucle de fil de travail et la glisser sur l’aiguille droite. Chaque boucle compte pour 1 maille"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tordre une boucle de fil de travail et la glisser sur l’aiguille droite. Chaque boucle compte pour 1 maille"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કામના દોરાથી એક ગાંઠ વાળો અને જમણી સળી પર સરકાવો. દરેક ગાંઠ 1 ફંદો છે"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סובב לולאה מחוט העבודה והחלק אותה על המסרגה הימנית. כל לולאה היא עין אחת"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कामकाजी धागे से एक लूप ऐंठें और दाईं सलाई पर खिसका दें। हर लूप 1 फंदा है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvrnuti omču radne niti i pomaknuti je na desnu iglu. Svaka omča je 1 petlja"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy hurok megcsavarása a munkafonalból és a jobb tűre csúsztatása. Minden hurok 1 szem"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Puntir satu simpul dari benang kerja dan geser ke jarum kanan. Setiap simpul adalah 1 jerat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attorcigliare un anello di filo di lavoro e farlo scivolare sul ferro destro. Ogni anello è 1 maglia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "糸で輪を作ってひねり、右針にかける。1つの輪が1目"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೆಲಸದ ದಾರದಿಂದ ಒಂದು ಕುಣಿಕೆ ತಿರುಚಿ ಬಲ ಸೂಜಿಗೆ ಜಾರಿಸಿ. ಪ್ರತಿ ಕುಣಿಕೆ 1 ಹೊಲಿಗೆ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 실로 고리를 꼬아 오른쪽 바늘에 끼우기. 고리 하나가 1코"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ജോലി നൂലിൽ നിന്ന് ഒരു കുടുക്ക് പിരിച്ച് വലത് സൂചിയിലേക്ക് നീക്കുക. ഓരോ കുടുക്കും 1 കണ്ണിയാണ്"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कामाच्या धाग्याची एक गाठ पिळा आणि उजव्या सुईवर सरकवा. प्रत्येक गाठ 1 टाका आहे"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintal satu simpulan benang kerja dan gelongsorkan ke jarum kanan. Setiap simpulan ialah 1 jerat"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vri en løkke av arbeidstråden og skyv den over på høyre pinne. Hver løkke er 1 maske"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draai een lus van de werkdraad en schuif hem op de rechternaald. Elke lus is 1 steek"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କାମ ସୂତାରୁ ଗୋଟିଏ ଫାଶ ମୋଡ଼ନ୍ତୁ ଏବଂ ଡାହାଣ ଛୁଞ୍ଚିକୁ ସରକାନ୍ତୁ। ପ୍ରତ୍ୟେକ ଫାଶ 1 ଫାଶ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੰਮ ਦੇ ਧਾਗੇ ਦਾ ਇੱਕ ਫੰਧਾ ਮਰੋੜੋ ਅਤੇ ਸੱਜੀ ਸਲਾਈ ਉੱਤੇ ਖਿਸਕਾਓ। ਹਰ ਫੰਧਾ 1 ਫੰਦਾ ਹੈ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skręcić pętlę z nitki roboczej i nasunąć ją na prawy drut. Każda pętla to 1 oczko"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Torcer uma laçada do fio de trabalho e deslizá-la para a agulha direita. Cada laçada é 1 ponto"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Torcer uma laçada do fio de trabalho e deslizá-la para a agulha direita. Cada laçada é 1 ponto"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răsucește o buclă din firul de lucru și alunecă-o pe andreaua dreaptă. Fiecare buclă este 1 ochi"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрутить петлю из рабочей нити и надеть на правую спицу. Каждая петля считается за 1 петлю"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrútiť slučku z pracovnej nite a posunúť ju na pravú ihlicu. Každá slučka je 1 očko"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zavij zanko iz delovne niti in jo potisni na desno iglo. Vsaka zanka je 1 zanka"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrid en ögla av arbetstråden och skjut den på högra stickan. Varje ögla är 1 maska"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வேலை நூலிலிருந்து ஒரு வளையத்தை முறுக்கி வலது ஊசியில் நகர்த்து. ஒவ்வொரு வளையமும் 1 கண்ணி"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పని దారంతో ఒక ఉచ్చును మెలితిప్పి కుడి సూదిపైకి జరపండి. ప్రతి ఉచ్చు 1 కుట్టు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บิดเส้นด้ายทำงานเป็นห่วงแล้วสอดเข้าไม้ขวา ทุกห่วงนับเป็น 1 ห่วง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışma ipinden bir ilik bük ve sağ şişe kaydır. Her ilik 1 ilmektir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрутити петлю з робочої нитки й надіти на праву спицю. Кожна петля вважається за 1 петлю"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کام کے دھاگے سے ایک حلقہ بل دیں اور دائیں سلائی پر کھسکائیں۔ ہر حلقہ 1 ٹانکا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xoắn một vòng từ sợi làm việc và trượt lên kim phải. Mỗi vòng là 1 mũi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把工作线绕成圈扭一下，滑到右针上。每个线圈算 1 针"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把工作線繞成圈扭一下，滑到右針上。每個線圈算 1 針"
          }
        }
      }
    },
