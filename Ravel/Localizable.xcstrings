    "One payment of %@. Every pattern is yours for good.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دفعة واحدة بقيمة %@. كل نمط ملكك للأبد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এর একবারের পেমেন্ট। প্রতিটি প্যাটার্ন চিরকাল আপনার।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sol pagament de %@. Tots els patrons són teus per sempre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna platba %@. Každý návod je váš navždy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Én enkelt betaling på %@. Alle opskrifter er dine for altid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmalige Zahlung von %@. Jedes Muster gehört dir für immer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μία πληρωμή %@. Κάθε σχέδιο είναι δικό σου για πάντα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo pago de %@. Todos los patrones son tuyos para siempre."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo pago de %@. Todos los patrones son tuyos para siempre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi maksu, %@. Jokainen ohje on sinun ikuisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul paiement de %@. Chaque modèle est à vous pour toujours."
