    "Purl 1 through the back loop, so the stitch twists": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احِك غرزة مقلوبة واحدة من الحلقة الخلفية، فتلتف الغرزة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পিছনের ফাঁস দিয়ে ১টি উল্টো ঘর বুনুন, ফলে ঘরটি পাক খায়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Teixir 1 punt del revés per darrere, de manera que el punt es torci"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uplést 1 oko obráceně za zadní článek, aby se oko zkroutilo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Strik 1 maske vrang i bagerste maskeled, så masken drejer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Masche links verschränkt stricken, sodass sich die Masche dreht"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πλέξε 1 ανάποδο βρόχο από το πίσω σκέλος, ώστε ο βρόχος να στρίψει"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tejer 1 punto del revés por la lazada de atrás, para que el punto se tuerza"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tejer 1 punto del revés por la lazada de atrás, para que el punto se tuerza"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Neulo 1 silmukka nurin takakautta, jolloin silmukka vääntyy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricoter 1 maille à l’envers par le brin arrière, pour que la maille se torde"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricoter 1 maille à l’envers par le brin arrière, pour que la maille se torde"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પાછળના આંટાથી 1 ઊંધો ફંદો ગૂંથો, જેથી ફંદો વળ ખાય"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סרוג עין הפוכה אחת דרך הלולאה האחורית, כך שהעין מתפתלת"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पीछे की लूप से 1 उल्टा फंदा बुनें, ताकि फंदा बल खाए"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Splesti 1 petlju lijevo straga, tako da se petlja uvije"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "1 szem fordítva kötése a szem hátsó szálán, hogy a szem megcsavarodjon"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Purl 1 jerat melalui lengkung belakang, sehingga jerat terpuntir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavorare 1 maglia a rovescio ritorto, nel filo di dietro, così la maglia si ritorce"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "向こう側の半目に針を入れて1目裏編みし、目をねじる"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹಿಂದಿನ ಲೂಪ್ ಮೂಲಕ 1 ಹಿಮ್ಮುಖ ಹೊಲಿಗೆ ಹೆಣೆಯಿರಿ, ಇದರಿಂದ ಹೊಲಿಗೆ ತಿರುಚಿಕೊಳ್ಳುತ್ತದೆ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뒤쪽 고리에 바늘을 넣어 1코 안뜨기, 코가 꼬이게 하기"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പിന്നിലെ ലൂപ്പിലൂടെ 1 തിരിച്ചുള്ള കണ്ണി തുന്നുക, അങ്ങനെ കണ്ണി പിരിയും"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मागच्या लूपमधून 1 उलटा टाका विणा, म्हणजे टाका पिळला जातो"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Purl 1 jerat melalui gelung belakang, supaya jerat berpintal"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Strikk 1 maske vrang i bakre maskebue, så masken vrir seg"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brei 1 steek averechts in het achterste lusje, zodat de steek draait"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପଛ ଲୁପ୍ ଦେଇ 1 ଓଲଟା ଫାଶ ବୁଣନ୍ତୁ, ଫଳରେ ଫାଶ ମୋଡ଼ି ହୁଏ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਿਛਲੇ ਲੂਪ ਰਾਹੀਂ 1 ਪੁੱਠਾ ਫੰਦਾ ਬੁਣੋ, ਤਾਂ ਜੋ ਫੰਦਾ ਵੱਟ ਖਾਵੇ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przerobić 1 oczko lewe za tylną ściankę, aby oczko się skręciło"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricotar 1 ponto no avesso pela alça de trás, para que o ponto fique torcido"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricotar 1 ponto no avesso pela alça de trás, para que o ponto fique torcido"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricotează 1 ochi de dos prin bucla din spate, ca ochiul să se răsucească"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Провязать 1 петлю изнаночной за заднюю стенку, чтобы петля перекрутилась"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upliesť 1 očko obrátene za zadný článok, aby sa očko skrútilo"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spleti 1 zanko levo od zadaj, da se zanka zasuka"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sticka 1 maska avig i bakre maskbågen, så att maskan vrids"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பின்புற லூப் வழியாக 1 தலைகீழ்க்கண்ணியைப் பின்னு, கண்ணி முறுக்கிக்கொள்ளும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వెనుక లూప్ ద్వారా 1 తిరగబడ్డ కుట్టు అల్లండి, కుట్టు మెలిక పడుతుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถักห่วงกลับ 1 ห่วงผ่านห่วงด้านหลัง ให้ห่วงบิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ilmeği arka teli üzerinden ters ör, ilmek bükülsün"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Провʼязати 1 петлю виворітною за задню стінку, щоб петля перекрутилася"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پچھلے لوپ سے 1 الٹا ٹانکا بنیں، تاکہ ٹانکا مڑ جائے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đan 1 mũi ngược qua vòng sau, để mũi bị xoắn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挑后面的线圈织 1 针上针，使针目扭转"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "挑後面的線圈織 1 針上針，使針目扭轉"
          }
        }
      }
    },
