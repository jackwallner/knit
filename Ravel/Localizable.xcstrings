    "Push the needle through the edge of the fabric, wrap the yarn and pull a loop through. Each loop is 1 stitch": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل الإبرة عبر حافة القماش، والفّ الخيط واسحب حلقة. كل حلقة تساوي غرزة واحدة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাঁটা কাপড়ের কিনারা দিয়ে ঢোকান, সুতো জড়িয়ে একটি ফাঁস টেনে বের করুন। প্রতিটি ফাঁস ১টি ঘর"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Passar l’agulla per la vora de la peça, envoltar el fil i treure un llaç. Cada llaç és 1 punt"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Protáhnout jehlici okrajem práce, ovinout nit a protáhnout smyčku. Každá smyčka je 1 oko"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stik pinden gennem kanten af arbejdet, læg tråden om, og træk en løkke igennem. Hver løkke er 1 maske"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nadel durch den Stoffrand stechen, den Faden umschlagen und eine Schlinge durchziehen. Jede Schlinge ist 1 Masche"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πέρασε τη βελόνα από την άκρη του υφάσματος, τύλιξε το νήμα και τράβηξε έναν βρόχο. Κάθε βρόχος είναι 1 βρόχος"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasar la aguja por el borde de la labor, rodear con la hebra y sacar un lazo. Cada lazo es 1 punto"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasar la aguja por el borde de la labor, rodear con la hebra y sacar un lazo. Cada lazo es 1 punto"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pujota puikko työn reunan läpi, kierrä lanka ja vedä silmukka läpi. Jokainen silmukka on 1 silmukka"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer l’aiguille dans le bord de l’ouvrage, enrouler le fil et tirer une boucle. Chaque boucle compte pour 1 maille"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer l’aiguille dans le bord de l’ouvrage, enrouler le fil et tirer une boucle. Chaque boucle compte pour 1 maille"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સળીને કાપડની કિનારીમાંથી પસાર કરો, દોરો વીંટો અને એક ગાંઠ ખેંચો. દરેક ગાંઠ 1 ફંદો છે"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכנס את המסרגה דרך שולי הבד, כרוך את החוט ומשוך לולאה. כל לולאה היא עין אחת"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सलाई को कपड़े के किनारे से निकालें, धागा लपेटें और एक लूप खींचें। हर लूप 1 फंदा है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provući iglu kroz rub rada, omotati nit i izvući omču. Svaka omča je 1 petlja"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tű átszúrása a munka szélén, a fonal körbetekerése és egy hurok áthúzása. Minden hurok 1 szem"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tusukkan jarum melalui tepi kain, lilitkan benang, lalu tarik satu simpul. Setiap simpul adalah 1 jerat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Infilare il ferro nel bordo del lavoro, avvolgere il filo e tirare fuori un anello. Ogni anello è 1 maglia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編み地の縁に針を通し、糸をかけて引き出す。1つの輪が1目"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸೂಜಿಯನ್ನು ಬಟ್ಟೆಯ ಅಂಚಿನ ಮೂಲಕ ತೂರಿಸಿ, ದಾರ ಸುತ್ತಿ ಕುಣಿಕೆ ಎಳೆಯಿರಿ. ಪ್ರತಿ ಕುಣಿಕೆ 1 ಹೊಲಿಗೆ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바늘을 천 가장자리에 넣고 실을 감아 고리를 빼내기. 고리 하나가 1코"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സൂചി തുണിയുടെ അറ്റത്തുകൂടി കടത്തി, നൂൽ ചുറ്റി ഒരു കുടുക്ക് വലിച്ചെടുക്കുക. ഓരോ കുടുക്കും 1 കണ്ണിയാണ്"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सुई कापडाच्या काठातून घाला, धागा गुंडाळा आणि एक गाठ ओढा. प्रत्येक गाठ 1 टाका आहे"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tusuk jarum melalui tepi kain, lilit benang dan tarik satu simpulan. Setiap simpulan ialah 1 jerat"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stikk pinnen gjennom kanten på arbeidet, legg tråden rundt og trekk opp en løkke. Hver løkke er 1 maske"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Steek de naald door de rand van het werk, sla de draad om en trek een lus door. Elke lus is 1 steek"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଛୁଞ୍ଚିକୁ କନାର କିନାରା ଦେଇ ପାର କରାନ୍ତୁ, ସୂତା ଗୁଡ଼ାନ୍ତୁ ଏବଂ ଗୋଟିଏ ଫାଶ ଟାଣନ୍ତୁ। ପ୍ରତ୍ୟେକ ଫାଶ 1 ଫାଶ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਲਾਈ ਨੂੰ ਕੱਪੜੇ ਦੇ ਕਿਨਾਰੇ ਵਿੱਚੋਂ ਲੰਘਾਓ, ਧਾਗਾ ਲਪੇਟੋ ਅਤੇ ਇੱਕ ਫੰਧਾ ਖਿੱਚੋ। ਹਰ ਫੰਧਾ 1 ਫੰਦਾ ਹੈ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wsunąć drut w brzeg robótki, owinąć nitkę i przeciągnąć pętlę. Każda pętla to 1 oczko"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passar a agulha pela borda do tecido, envolver o fio e puxar uma laçada. Cada laçada é 1 ponto"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Passar a agulha pela borda do tecido, envolver o fio e puxar uma laçada. Cada laçada é 1 ponto"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Treci andreaua prin marginea lucrării, înfășoară firul și trage o buclă. Fiecare buclă este 1 ochi"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Провести спицу сквозь край полотна, обернуть нить и вытянуть петлю. Каждая петля считается за 1 петлю"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevliecť ihlicu okrajom práce, ovinúť niť a pretiahnuť slučku. Každá slučka je 1 očko"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potisni iglo skozi rob dela, ovij nit in potegni zanko skozi. Vsaka zanka je 1 zanka"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För stickan genom kanten på arbetet, lägg tråden om och dra igenom en ögla. Varje ögla är 1 maska"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஊசியைத் துணியின் விளிம்பில் செலுத்தி, நூலைச் சுற்றி ஒரு வளையத்தை இழு. ஒவ்வொரு வளையமும் 1 கண்ணி"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సూదిని వస్త్రం అంచు గుండా దూర్చి, దారం చుట్టి ఒక ఉచ్చును లాగండి. ప్రతి ఉచ్చు 1 కుట్టు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สอดไม้ถักผ่านขอบผ้า คล้องด้ายแล้วดึงห่วงออกมา ทุกห่วงนับเป็น 1 ห่วง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şişi işin kenarından geçir, ipi sar ve bir ilik çek. Her ilik 1 ilmektir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Провести спицю крізь край полотна, обернути нитку й витягти петлю. Кожна петля вважається за 1 петлю"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سلائی کو کپڑے کے کنارے سے گزاریں، دھاگا لپیٹیں اور ایک حلقہ کھینچ لیں۔ ہر حلقہ 1 ٹانکا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đưa kim qua mép vải, quấn sợi và kéo một vòng ra. Mỗi vòng là 1 mũi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将针穿过织物边缘，绕线并拉出一个线圈。每个线圈算 1 针"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將針穿過織物邊緣，繞線並拉出一個線圈。每個線圈算 1 針"
          }
        }
      }
    },
