    "Knit the knit stitches and purl the purl stitches as you bind off": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الإغلاق، احِك الغرز العادية عادية والمقلوبة مقلوبة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বন্ধ করার সময় সোজা ঘর সোজা এবং উল্টো ঘর উল্টো বুনুন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Teixir els punts del dret del dret i els del revés del revés en cloure"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při uzavírání plést hladká oka hladce a obrácená obráceně"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Strik de rette masker ret og de vrange masker vrang, når du lukker af"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Abketten rechte Maschen rechts und linke Maschen links stricken"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο κλείσιμο πλέξε τους ίσιους βρόχους ίσια και τους ανάποδους ανάποδα"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tejer los puntos del derecho del derecho y los del revés del revés al cerrar"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tejer los puntos del derecho del derecho y los del revés del revés al cerrar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Neulo oikeat silmukat oikein ja nurjat nurin päätellessäsi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricoter les mailles endroit à l’endroit et les mailles envers à l’envers en rabattant"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricoter les mailles endroit à l’endroit et les mailles envers à l’envers en rabattant"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બંધ કરતી વખતે સીધા ફંદા સીધા અને ઊંધા ફંદા ઊંધા ગૂંથો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בסגירה סרוג עיניים ישרות כישרות ועיניים הפוכות כהפוכות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद करते समय सीधे फंदे सीधे और उल्टे फंदे उल्टे बुनें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri zatvaranju plesti desne petlje desno, a lijeve lijevo"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lezáráskor a sima szemek simán, a fordított szemek fordítva kötése"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat menutup, rajut jerat rajut sebagai rajut dan jerat purl sebagai purl"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudendo, lavorare le maglie a dritto a dritto e quelle a rovescio a rovescio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "伏せ止めでは、表目は表目、裏目は裏目のまま編む"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮುಚ್ಚುವಾಗ ನೇರ ಹೊಲಿಗೆಗಳನ್ನು ನೇರವಾಗಿ ಮತ್ತು ಹಿಮ್ಮುಖ ಹೊಲಿಗೆಗಳನ್ನು ಹಿಮ್ಮುಖವಾಗಿ ಹೆಣೆಯಿರಿ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코 막음할 때 겉뜨기 코는 겉뜨기로, 안뜨기 코는 안뜨기로 뜨기"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അടയ്ക്കുമ്പോൾ നേരെയുള്ള കണ്ണികൾ നേരെയും തിരിച്ചുള്ളവ തിരിച്ചും തുന്നുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद करताना सरळ टाके सरळ आणि उलटे टाके उलटे विणा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semasa menutup, rajut jerat rajut sebagai rajut dan jerat purl sebagai purl"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Strikk rette masker rett og vrange masker vrang når du feller av"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brei de rechte steken recht en de averechte steken averechts tijdens het afkanten"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବନ୍ଦ କଲାବେଳେ ସିଧା ଫାଶ ସିଧା ଓ ଓଲଟା ଫାଶ ଓଲଟା ବୁଣନ୍ତୁ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬੰਦ ਕਰਦੇ ਸਮੇਂ ਸਿੱਧੇ ਫੰਦੇ ਸਿੱਧੇ ਅਤੇ ਪੁੱਠੇ ਫੰਦੇ ਪੁੱਠੇ ਬੁਣੋ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy zamykaniu przerabiać oczka prawe prawymi, a lewe lewymi"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricotar os pontos lisos no liso e os avessos no avesso ao arrematar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricotar os pontos lisos no liso e os avessos no avesso ao arrematar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La închidere, tricotează ochiurile de față pe față și pe cele de dos pe dos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При закрытии провязывать лицевые петли лицевыми, а изнаночные изнаночными"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri uzatváraní plesť hladké očká hladko a obrátené obrátene"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri zaključevanju spleti desne zanke desno in leve zanke levo"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sticka de räta maskorna räta och de aviga aviga när du maskar av"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மூடும்போது நேர்க்கண்ணிகளை நேராகவும் தலைகீழ்க்கண்ணிகளை தலைகீழாகவும் பின்னு"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మూసివేసేటప్పుడు నేరు కుట్లను నేరుగా, తిరగబడ్డ కుట్లను తిరగబడినట్లు అల్లండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนปิดงาน ถักห่วงตรงเป็นห่วงตรงและห่วงกลับเป็นห่วงกลับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlarken düz ilmekleri düz, ters ilmekleri ters ör"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час закриття провʼязувати лицьові петлі лицьовими, а виворітні виворітними"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بند کرتے وقت سیدھے ٹانکے سیدھے اور الٹے ٹانکے الٹے بنیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi kết thúc, đan mũi xuôi thành mũi xuôi và mũi ngược thành mũi ngược"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收针时，下针织下针，上针织上针"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收針時，下針織下針，上針織上針"
          }
        }
      }
    },
