        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fläta 4 fram: lyft 2 maskor på en flätsticka och håll den framför, sticka 2, sticka sedan de 2 från flätstickan"
          }
        },
        "ta": {
