            "value": "חשבון Apple הזה כבר ניצל את השבוע החינמי שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Apple खाता अपना मुफ़्त सप्ताह पहले ही ले चुका है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj Apple račun već je iskoristio besplatni tjedan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az Apple-fiók már kihasználta az ingyenes hetét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun Apple ini sudah memakai minggu gratisnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo account Apple ha già usato la sua settimana gratuita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このApple Accountは無料の1週間をすでに使っています。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ Apple ಖಾತೆ ಈಗಾಗಲೇ ತನ್ನ ಉಚಿತ ವಾರವನ್ನು ಬಳಸಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
