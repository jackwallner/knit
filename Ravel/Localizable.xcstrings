    "%@, billed today. Auto-renews until canceled.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@، تُحاسَب اليوم. يتجدد تلقائيًا حتى تلغيه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, আজ বিল হবে। আপনি বাতিল না করা পর্যন্ত স্বয়ংক্রিয়ভাবে নবায়ন হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, cobrat avui. Es renova automàticament fins que cancel·lis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, účtováno dnes. Obnovuje se automaticky, dokud nezrušíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, betales i dag. Fornyes automatisk, indtil du opsiger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, heute berechnet. Verlängert sich automatisch, bis du kündigst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, χρέωση σήμερα. Ανανεώνεται αυτόματα μέχρι να ακυρώσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, cobrado hoy. Se renueva automáticamente hasta que canceles."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, cobrado hoy. Se renueva automáticamente hasta que canceles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, veloitetaan tänään. Uusiutuu automaattisesti, kunnes perut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, facturé aujourd’hui. Se renouvelle automatiquement jusqu’à résiliation."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, facturé aujourd’hui. Se renouvelle automatiquement jusqu’à résiliation."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, આજે બિલ થશે. તમે રદ ન કરો ત્યાં સુધી આપમેળે નવીકરણ થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, החיוב היום. מתחדש אוטומטית עד שתבטל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, आज बिल किया जाएगा। रद्द करने तक अपने आप नवीनीकरण होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, naplaćuje se danas. Automatski se obnavlja dok ne otkažete."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ma kerül levonásra. Automatikusan megújul, amíg le nem mondod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ditagih hari ini. Diperpanjang otomatis sampai Anda membatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, addebitato oggi. Si rinnova automaticamente finché non annulli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@、本日お支払い。解約するまで自動更新されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ಇಂದು ಬಿಲ್ ಆಗುತ್ತದೆ. ನೀವು ರದ್ದುಪಡಿಸುವವರೆಗೆ ತಾನಾಗಿ ನವೀಕರಣಗೊಳ್ಳುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, 오늘 결제돼요. 해지할 때까지 자동 갱신돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ഇന്ന് ബിൽ ചെയ്യും. റദ്ദാക്കുന്നതുവരെ സ്വയം പുതുക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, आज बिल केले जाईल. तुम्ही रद्द करेपर्यंत आपोआप नूतनीकरण होते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, dibilkan hari ini. Diperbaharui secara automatik sehingga anda membatalkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, belastes i dag. Fornyes automatisk til du sier opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, vandaag in rekening gebracht. Wordt automatisch verlengd tot je opzegt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ଆଜି ବିଲ୍ ହେବ। ଆପଣ ବାତିଲ୍ ନକରିବା ପର୍ଯ୍ୟନ୍ତ ସ୍ୱୟଂଚାଳିତ ନବୀକରଣ ହୁଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ਅੱਜ ਬਿਲ ਹੋਵੇਗਾ। ਜਦੋਂ ਤੱਕ ਤੁਸੀਂ ਰੱਦ ਨਹੀਂ ਕਰਦੇ, ਆਪਣੇ-ਆਪ ਨਵਿਆਇਆ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, płatne dziś. Odnawia się automatycznie, dopóki nie anulujesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, cobrado hoje. Renova automaticamente até você cancelar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, cobrado hoje. Renova automaticamente até cancelares."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, taxat astăzi. Se reînnoiește automat până anulezi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, списание сегодня. Продлевается автоматически, пока вы не отмените."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, účtované dnes. Automaticky sa obnovuje, kým nezrušíte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, zaračunano danes. Samodejno se obnavlja, dokler ne prekličete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, debiteras i dag. Förnyas automatiskt tills du avbryter."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, இன்று கட்டணம் வசூலிக்கப்படும். நீங்கள் ரத்து செய்யும் வரை தானாகப் புதுப்பிக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ఈ రోజే బిల్ చేయబడుతుంది. మీరు రద్దు చేసే వరకు ఆటోమేటిక్‌గా పునరుద్ధరించబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ เรียกเก็บเงินวันนี้ ต่ออายุอัตโนมัติจนกว่าคุณจะยกเลิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, bugün tahsil edilir. İptal edene kadar otomatik yenilenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, списання сьогодні. Поновлюється автоматично, доки ви не скасуєте."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@، آج بل کیا جائے گا۔ جب تک آپ منسوخ نہ کریں خودبخود تجدید ہوتی رہتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, thanh toán hôm nay. Tự động gia hạn cho đến khi bạn hủy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，今天扣款。到你取消前会自动续订。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，今天扣款。到你取消前會自動續訂。"
          }
        }
      }
    },
