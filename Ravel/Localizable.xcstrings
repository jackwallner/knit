        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrkoč 4 vpredu: prehodiť 2 očká na pomocnú ihlicu a nechať ju vpredu, upliesť 2, potom upliesť 2 očká z pomocnej ihlice"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kita 4 spredaj: prenesi 2 zanki na pomožno iglo in jo pusti spredaj, spleti 2, nato spleti 2 zanki s pomožne igle"
