    "They are still on this %@. Restart it, then open Ravel again.": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara són en aquest %@. Reinicia’l i torna a obrir Ravel."
