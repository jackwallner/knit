    "Cable 6 front: slip 3 stitches to a cable needle and hold it in front, knit 3, then knit the 3 from the cable needle": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Trena de 6 al davant: passar 3 punts a una agulla auxiliar i deixar-la al davant, teixir 3 i després teixir els 3 de l’agulla auxiliar"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cop 6 vpředu: přendat 3 oka na pomocnou jehlici a nechat ji vpředu, uplést 3, pak uplést 3 oka z pomocné jehlice"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fletning på 6 foran: løft 3 masker over på en flettepind og lad den ligge foran, strik 3, og strik derefter de 3 fra flettepinden"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "6 Maschen Zopf nach vorn: 3 Maschen auf eine Zopfnadel abheben und vor die Arbeit legen, 3 Maschen rechts stricken, dann die 3 Maschen von der Zopfnadel rechts stricken"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenza de 6 delante: pasar 3 puntos a una aguja auxiliar y dejarla delante, tejer 3 y luego tejer los 3 de la aguja auxiliar"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenza de 6 delante: pasar 3 puntos a una aguja auxiliar y dejarla delante, tejer 3 y luego tejer los 3 de la aguja auxiliar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palmikko 6 edessä: siirrä 3 silmukkaa palmikkopuikolle ja jätä se eteen, neulo 3, neulo sitten palmikkopuikon 3 silmukkaa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Torsade de 6 devant : glisser 3 mailles sur une aiguille à torsades et la laisser devant, tricoter 3 mailles, puis tricoter les 3 mailles de l’aiguille à torsades"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Torsade de 6 devant : glisser 3 mailles sur une aiguille à torsades et la laisser devant, tricoter 3 mailles, puis tricoter les 3 mailles de l’aiguille à torsades"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Treccia di 6 davanti: passare 3 maglie su un ferro ausiliario e tenerlo davanti, lavorare 3 a dritto, poi lavorare le 3 del ferro ausiliario"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fletting 6 foran: løft 3 masker over på en flettepinne og la den ligge foran, strikk 3, og strikk så de 3 fra flettepinnen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabel 6 voor: haal 3 steken af op een kabelnaald en laat die voor het werk hangen, brei 3 steken en brei dan de 3 van de kabelnaald"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Warkocz 6 z przodu: zdjąć 3 oczka na drut pomocniczy i zostawić go z przodu, przerobić 3, potem przerobić 3 oczka z drutu pomocniczego"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trança de 6 na frente: passar 3 pontos para uma agulha de trança e deixá-la na frente, tricotar 3 e depois tricotar os 3 da agulha de trança"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Trança de 6 na frente: passar 3 pontos para uma agulha de trança e deixá-la na frente, tricotar 3 e depois tricotar os 3 da agulha de trança"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrkoč 6 vpredu: prehodiť 3 očká na pomocnú ihlicu a nechať ju vpredu, upliesť 3, potom upliesť 3 očká z pomocnej ihlice"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fläta 6 fram: lyft 3 maskor på en flätsticka och håll den framför, sticka 3, sticka sedan de 3 från flätstickan"
          }
        }
      }
    },
