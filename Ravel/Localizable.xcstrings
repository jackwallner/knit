    "Swap the needles between your hands and work back the other way": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Canviar les agulles de mà i treballar en sentit contrari"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyměnit jehlice v rukou a plést zpět opačným směrem"
