    "Knit 1 through the back loop, so the stitch twists": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احِك غرزة واحدة من الحلقة الخلفية، فتلتف الغرزة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পিছনের ফাঁস দিয়ে ১টি ঘর বুনুন, ফলে ঘরটি পাক খায়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Teixir 1 punt per darrere, de manera que el punt es torci"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uplést 1 oko za zadní článek, aby se oko zkroutilo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Strik 1 maske i bagerste maskeled, så masken drejer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Masche rechts verschränkt stricken, sodass sich die Masche dreht"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πλέξε 1 βρόχο από το πίσω σκέλος, ώστε ο βρόχος να στρίψει"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tejer 1 punto por la lazada de atrás, para que el punto se tuerza"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tejer 1 punto por la lazada de atrás, para que el punto se tuerza"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Neulo 1 silmukka takakautta, jolloin silmukka vääntyy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricoter 1 maille à l’endroit par le brin arrière, pour que la maille se torde"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricoter 1 maille à l’endroit par le brin arrière, pour que la maille se torde"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પાછળના આંટાથી 1 ફંદો ગૂંથો, જેથી ફંદો વળ ખાય"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סרוג עין אחת דרך הלולאה האחורית, כך שהעין מתפתלת"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पीछे की लूप से 1 फंदा बुनें, ताकि फंदा बल खाए"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Splesti 1 petlju desno straga, tako da se petlja uvije"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "1 szem kötése a szem hátsó szálán, hogy a szem megcsavarodjon"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rajut 1 jerat melalui lengkung belakang, sehingga jerat terpuntir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavorare 1 maglia a dritto ritorto, nel filo di dietro, così la maglia si ritorce"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "向こう側の半目に針を入れて1目編み、目をねじる"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹಿಂದಿನ ಲೂಪ್ ಮೂಲಕ 1 ಹೊಲಿಗೆ ಹೆಣೆಯಿರಿ, ಇದರಿಂದ ಹೊಲಿಗೆ ತಿರುಚಿಕೊಳ್ಳುತ್ತದೆ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뒤쪽 고리에 바늘을 넣어 1코 겉뜨기, 코가 꼬이게 하기"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പിന്നിലെ ലൂപ്പിലൂടെ 1 കണ്ണി തുന്നുക, അങ്ങനെ കണ്ണി പിരിയും"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मागच्या लूपमधून 1 टाका विणा, म्हणजे टाका पिळला जातो"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rajut 1 jerat melalui gelung belakang, supaya jerat berpintal"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Strikk 1 maske i bakre maskebue, så masken vrir seg"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brei 1 steek in het achterste lusje, zodat de steek draait"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପଛ ଲୁପ୍ ଦେଇ 1 ଫାଶ ବୁଣନ୍ତୁ, ଫଳରେ ଫାଶ ମୋଡ଼ି ହୁଏ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਿਛਲੇ ਲੂਪ ਰਾਹੀਂ 1 ਫੰਦਾ ਬੁਣੋ, ਤਾਂ ਜੋ ਫੰਦਾ ਵੱਟ ਖਾਵੇ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przerobić 1 oczko za tylną ściankę, aby oczko się skręciło"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricotar 1 ponto pela alça de trás, para que o ponto fique torcido"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricotar 1 ponto pela alça de trás, para que o ponto fique torcido"
          }
