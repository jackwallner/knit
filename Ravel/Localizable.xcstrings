    "Make 1 left: lift the bar from the front and knit it through the back": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Augment d’1 a l’esquerra: aixecar el fil per davant i teixir-lo per darrere"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidat 1 doleva: zvednout nit zepředu a uplést ji zezadu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag 1 maske op mod venstre: løft tråden forfra og strik den bagfra"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Masche links geneigt zunehmen: den Querfaden von vorn aufnehmen und hinten verschränkt rechts stricken"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumento de 1 a la izquierda: levantar la hebra desde delante y tejerla por detrás"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumento de 1 a la izquierda: levantar la hebra desde delante y tejerla por detrás"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää 1 vasemmalle: nosta lanka edestä ja neulo se takaa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmentation de 1 à gauche : relever le fil par l’avant et le tricoter par le brin arrière"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmentation de 1 à gauche : relever le fil par l’avant et le tricoter par le brin arrière"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumento di 1 a sinistra: sollevare il filo da davanti e lavorarlo dietro"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Øk 1 mot venstre: løft tråden forfra og strikk den bakfra"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1 steek meerderen naar links: haal de draad van voren op en brei hem achter af"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodać 1 oczko w lewo: unieść nitkę od przodu i przerobić ją od tyłu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumento de 1 à esquerda: levantar o fio pela frente e tricotá-lo pela parte de trás"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumento de 1 à esquerda: levantar o fio pela frente e tricotá-lo pela parte de trás"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridať 1 doľava: zdvihnúť niť spredu a upliesť ju zozadu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öka 1 åt vänster: lyft tråden framifrån och sticka den bakifrån"
          }
        }
      }
    },
