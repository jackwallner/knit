    "Ravel could not write to this %@. Free up some storage, then make the change again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Ravel الكتابة على هذا الجهاز (%@). حرّر بعض المساحة ثم أعد التغيير."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel এই %@-এ লিখতে পারেনি। কিছু স্টোরেজ খালি করে আবার পরিবর্তনটি করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel no ha pogut escriure en aquest %@. Allibera espai d'emmagatzematge i torna a fer el canvi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel nemohl zapisovat na tento %@. Uvolněte místo v úložišti a změnu proveďte znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel kunne ikke skrive til denne %@. Frigør lidt lagerplads, og foretag ændringen igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel konnte nicht auf dieses %@ schreiben. Gib etwas Speicherplatz frei und nimm die Änderung dann noch einmal vor."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Ravel δεν μπόρεσε να γράψει σε αυτό το %@. Ελευθέρωσε χώρο αποθήκευσης και κάνε ξανά την αλλαγή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel no pudo escribir en este %@. Libera espacio de almacenamiento y vuelve a hacer el cambio."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel no pudo escribir en este %@. Libera espacio de almacenamiento y vuelve a hacer el cambio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel ei voinut kirjoittaa laitteelle: %@. Vapauta tallennustilaa ja tee muutos uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel n'a pas pu écrire sur cet %@. Libérez de l'espace de stockage, puis refaites la modification."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel n'a pas pu écrire sur cet %@. Libérez de l'espace de stockage, puis refaites la modification."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel આ %@ પર લખી શક્યું નહીં. થોડી સ્ટોરેજ ખાલી કરો, પછી ફેરફાર ફરીથી કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel לא הצליח לכתוב ב־%@ הזה. פנה קצת מקום באחסון ובצע את השינוי שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel इस %@ पर लिख नहीं सका। कुछ स्टोरेज खाली करें, फिर बदलाव दोबारा करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel nije mogao pisati na ovaj uređaj (%@). Oslobodite malo prostora za pohranu pa ponovite promjenu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Ravel nem tudott írni ezen: %@. Szabadíts fel tárhelyet, majd csináld meg újra a módosítást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel tidak dapat menulis ke %@ ini. Kosongkan sebagian penyimpanan, lalu ulangi perubahan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel non ha potuto scrivere su questo %@. Libera spazio di archiviazione, poi rifai la modifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravelはこの%@に書き込めませんでした。ストレージの空き容量を増やして、もう一度変更してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel ಈ %@ ಗೆ ಬರೆಯಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಸ್ವಲ್ಪ ಸಂಗ್ರಹಣೆ ಖಾಲಿ ಮಾಡಿ, ನಂತರ ಬದಲಾವಣೆಯನ್ನು ಮತ್ತೆ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel이 이 %@에 쓸 수 없었어요. 저장 공간을 확보한 다음 변경을 다시 해 주세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel-ന് ഈ %@-ൽ എഴുതാനായില്ല. കുറച്ച് സ്റ്റോറേജ് ഒഴിവാക്കി, മാറ്റം വീണ്ടും വരുത്തുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel या %@ वर लिहू शकले नाही. थोडी स्टोरेज जागा मोकळी करा, मग बदल पुन्हा करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel tidak dapat menulis pada %@ ini. Kosongkan sedikit storan, kemudian buat perubahan itu sekali lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel kunne ikke skrive til denne enheten (%@). Frigjør litt lagringsplass, og gjør endringen på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel kon niet schrijven naar dit apparaat (%@). Maak wat opslagruimte vrij en voer de wijziging opnieuw door."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel ଏହି %@ ରେ ଲେଖି ପାରିଲା ନାହିଁ। କିଛି ଷ୍ଟୋରେଜ୍ ଖାଲି କରନ୍ତୁ, ତା’ପରେ ପରିବର୍ତ୍ତନ ପୁଣି କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel ਇਸ %@ ਉੱਤੇ ਲਿਖ ਨਹੀਂ ਸਕਿਆ। ਕੁਝ ਸਟੋਰੇਜ ਖਾਲੀ ਕਰੋ, ਫਿਰ ਤਬਦੀਲੀ ਦੁਬਾਰਾ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel nie mógł zapisać danych na tym urządzeniu (%@). Zwolnij trochę miejsca w pamięci i wprowadź zmianę jeszcze raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Ravel não conseguiu gravar neste %@. Libere espaço de armazenamento e faça a alteração de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Ravel não conseguiu gravar neste %@. Libere espaço de armazenamento e faça a alteração de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel nu a putut scrie pe acest %@. Eliberează spațiu de stocare, apoi fă din nou modificarea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel не смог записать данные на устройство (%@). Освободите место в хранилище и повторите изменение."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel nemohol zapisovať na toto zariadenie (%@). Uvoľnite miesto v úložisku a zmenu urobte znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel ni mogel pisati na napravo (%@). Sprostite nekaj prostora za shranjevanje in spremembo ponovite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel kunde inte skriva till den här enheten (%@). Frigör lite lagringsutrymme och gör ändringen igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த %@ இல் Ravel-ஆல் எழுத முடியவில்லை. சிறிது சேமிப்பிடத்தை காலி செய்து, மாற்றத்தை மீண்டும் செய்யுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel ఈ %@ లో రాయలేకపోయింది. కొంత స్టోరేజ్ ఖాళీ చేసి, మార్పును మళ్లీ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel เขียนข้อมูลลง %@ เครื่องนี้ไม่ได้ ลองเคลียร์พื้นที่เก็บข้อมูล แล้วทำการเปลี่ยนแปลงอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel bu cihaza (%@) yazamadı. Biraz depolama alanı boşaltın, ardından değişikliği yeniden yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel не зміг записати дані на пристрій (%@). Звільніть місце в сховищі та повторіть зміну."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel اس %@ پر نہیں لکھ سکا۔ کچھ اسٹوریج خالی کریں، پھر تبدیلی دوبارہ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel không ghi được vào %@ này. Hãy giải phóng bớt dung lượng, rồi thực hiện lại thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel 无法写入这台%@。请腾出一些存储空间，然后重新修改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravel 無法寫入這台%@。請釋出一些儲存空間，然後重新修改。"
          }
        }
      }
    },
