    "Knit the first cast-on stitch with the working yarn to close the circle, with the cast-on edge lying flat, not spiraled, around the needle": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Teixir el primer punt muntat amb el fil de treball per tancar el cercle, amb la vora de muntatge plana i sense torçar al voltant de l’agulla"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uplést první nahozené oko pracovní nití, abyste uzavřeli kruh, s nahazovacím okrajem rovně, ne zkrouceným kolem jehlice"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Strik den første opslåede maske med arbejdstråden for at lukke ringen, med opslagskanten flad og ikke snoet rundt om pinden"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erste angeschlagene Masche mit dem Arbeitsfaden stricken, um den Kreis zu schließen. Die Anschlagkante liegt flach um die Nadel und ist nicht verdreht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tejer el primer punto montado con la hebra de trabajo para cerrar el círculo, con el borde de montaje plano y sin torcer alrededor de la aguja"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tejer el primer punto montado con la hebra de trabajo para cerrar el círculo, con el borde de montaje plano y sin torcer alrededor de la aguja"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Neulo ensimmäinen luotu silmukka työlangalla ympyrän sulkemiseksi niin, että luomisreuna on tasaisena eikä kierteellä puikon ympärillä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricoter la première maille montée avec le fil de travail pour fermer le cercle, le bord de montage à plat, sans torsion autour de l’aiguille"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricoter la première maille montée avec le fil de travail pour fermer le cercle, le bord de montage à plat, sans torsion autour de l’aiguille"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavorare la prima maglia avviata con il filo di lavoro per chiudere il cerchio, con il bordo di avvio piatto e non attorcigliato intorno al ferro"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Strikk den første oppleggsmasken med arbeidstråden for å lukke ringen, med oppleggskanten flat og ikke vridd rundt pinnen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brei de eerste opgezette steek met de werkdraad om de cirkel te sluiten, met de opzetrand plat en niet gedraaid om de naald"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przerobić pierwsze nabrane oczko nitką roboczą, aby zamknąć koło, z brzegiem nabierania płasko, nieskręconym wokół drutu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricotar o primeiro ponto montado com o fio de trabalho para fechar o círculo, com a borda de montagem reta, sem torcer, ao redor da agulha"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricotar o primeiro ponto montado com o fio de trabalho para fechar o círculo, com a borda de montagem reta, sem torcer, ao redor da agulha"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upliesť prvé nahodené očko pracovnou niťou, aby ste uzavreli kruh, s nahadzovacím okrajom rovno, nie skrúteným okolo ihlice"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sticka den första upplagda maskan med arbetstråden för att sluta ringen, med uppläggningskanten platt och inte vriden runt stickan"
          }
        }
      }
    },
    "Knit the knit stitches and purl the purl stitches as you bind off": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Teixir els punts del dret del dret i els del revés del revés en cloure"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při uzavírání plést hladká oka hladce a obrácená obráceně"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Strik de rette masker ret og de vrange masker vrang, når du lukker af"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Abketten rechte Maschen rechts und linke Maschen links stricken"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tejer los puntos del derecho del derecho y los del revés del revés al cerrar"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tejer los puntos del derecho del derecho y los del revés del revés al cerrar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Neulo oikeat silmukat oikein ja nurjat nurin päätellessäsi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricoter les mailles endroit à l’endroit et les mailles envers à l’envers en rabattant"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricoter les mailles endroit à l’endroit et les mailles envers à l’envers en rabattant"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudendo, lavorare le maglie a dritto a dritto e quelle a rovescio a rovescio"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Strikk rette masker rett og vrange masker vrang når du feller av"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brei de rechte steken recht en de averechte steken averechts tijdens het afkanten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy zamykaniu przerabiać oczka prawe prawymi, a lewe lewymi"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricotar os pontos lisos no liso e os avessos no avesso ao arrematar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tricotar os pontos lisos no liso e os avessos no avesso ao arrematar"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri uzatváraní plesť hladké očká hladko a obrátené obrátene"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sticka de räta maskorna räta och de aviga aviga när du maskar av"
          }
        }
      }
    },
