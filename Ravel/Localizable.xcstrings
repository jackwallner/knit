    "Graft two rows of live stitches together with a tapestry needle, so the join looks like knitting": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اربط صفين من الغرز المفتوحة بإبرة تطريز بحيث يبدو الوصل كأنه حياكة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "খোলা ঘরের দুই সারি টেপেস্ট্রি সুচ দিয়ে জুড়ুন, যাতে জোড়াটি বোনার মতো দেখায়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Unir dues voltes de punts vius amb una agulla de llana, perquè la unió sembli teixit"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sešít dvě řady nezavřených ok jehlou, aby spoj vypadal jako pletení"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sy to rækker aktive masker sammen med en stoppenål, så samlingen ligner strikning"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Reihen offener Maschen mit einer Sticknadel zusammennähen, sodass die Naht wie Gestricktes aussieht"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένωσε δύο σειρές ανοιχτών βρόχων με βελόνα ραψίματος, ώστε η ένωση να μοιάζει με πλέξιμο"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unir dos hileras de puntos vivos con una aguja lanera, de modo que la unión parezca tejido"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Unir dos hileras de puntos vivos con una aguja lanera, de modo que la unión parezca tejido"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä kaksi riviä lepäävää silmukkaa villaneulalla, niin että saumakohta näyttää neulokselta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assembler deux rangs de mailles en attente avec une aiguille à laine, pour que la jonction ressemble à du tricot"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Assembler deux rangs de mailles en attente avec une aiguille à laine, pour que la jonction ressemble à du tricot"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખુલ્લા ફંદાની બે હરોળ ટેપેસ્ટ્રી સોયથી જોડો, જેથી જોડાણ ગૂંથણ જેવું દેખાય"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תפור יחד שתי שורות של עיניים פתוחות במחט רקמה, כך שהחיבור ייראה כמו סריגה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खुले फंदों की दो पंक्तियों को टेपेस्ट्री सुई से जोड़ें, ताकि जोड़ बुनाई जैसा दिखे"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spojiti dva reda otvorenih petlji iglom za vunu tako da spoj izgleda kao pletenje"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Két sor élő szem összevarrása hímzőtűvel, hogy az illesztés kötésnek tűnjön"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jahit dua baris jerat aktif dengan jarum tapestri agar sambungan tampak seperti rajutan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unire due ferri di maglie vive con un ago da lana, in modo che la giunzione sembri lavorata a maglia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "休み目2段をとじ針ではぎ合わせ、つなぎ目が編み地のように見える"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ತೆರೆದ ಹೊಲಿಗೆಗಳ ಎರಡು ಸಾಲುಗಳನ್ನು ಟೇಪೆಸ್ಟ್ರಿ ಸೂಜಿಯಿಂದ ಜೋಡಿಸಿ, ಜೋಡಣೆ ಹೆಣಿಗೆಯಂತೆ ಕಾಣುವಂತೆ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쉬는 코 두 단을 돗바늘로 이어 이음선이 뜨개처럼 보이게 하기"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തുറന്ന കണ്ണികളുടെ രണ്ട് നിരകൾ ടേപ്പെസ്ട്രി സൂചി കൊണ്ട് യോജിപ്പിക്കുക, ജോയിന്റ് തുന്നലുപോലെ തോന്നാൻ"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उघड्या टाक्यांच्या दोन ओळी टेपेस्ट्री सुईने जोडा, म्हणजे जोड विणकामासारखा दिसेल"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jahit dua baris jerat aktif dengan jarum tapestri supaya sambungan nampak seperti rajutan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sy sammen to rader med åpne masker med en stoppenål, så skjøten ser strikket ut"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee rijen losse steken met een stopnaald aan elkaar naaien, zodat de naad op breiwerk lijkt"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଖୋଲା ଫାଶର ଦୁଇ ଧାଡ଼ିକୁ ଟେପେଷ୍ଟ୍ରି ଛୁଞ୍ଚିରେ ଯୋଡ଼ନ୍ତୁ, ଯେପରି ଯୋଡ଼ ବୁଣା ପରି ଦେଖାଯିବ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਖੁੱਲ੍ਹੇ ਫੰਦਿਆਂ ਦੀਆਂ ਦੋ ਕਤਾਰਾਂ ਨੂੰ ਟੇਪੇਸਟਰੀ ਸੂਈ ਨਾਲ ਜੋੜੋ, ਤਾਂ ਜੋ ਜੋੜ ਬੁਣਾਈ ਵਰਗਾ ਦਿਸੇ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zszyć dwa rzędy oczek na żywo igłą do wełny, tak aby szew wyglądał jak dzianina"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Unir duas carreiras de pontos abertos com uma agulha de tapeçaria, de modo que a união pareça tricô"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Unir duas carreiras de pontos abertos com uma agulha de tapeçaria, de modo que a união pareça tricô"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Coase două rânduri de ochiuri vii cu un ac de tapiserie, astfel încât îmbinarea să arate ca tricotajul"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сшить два ряда живых петель иглой так, чтобы шов выглядел как вязание"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zošiť dva rady nezavretých očok ihlou, aby spoj vyzeral ako pletenie"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zašij dve vrsti odprtih zank z iglo za volno, da spoj izgleda kot pletenje"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sy ihop två varv med aktiva maskor med en stoppnål, så att skarven ser stickad ut"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "திறந்த கண்ணிகளின் இரண்டு வரிசைகளை டேப்ஸ்ட்ரி ஊசியால் இணை, இணைப்பு பின்னல்போலத் தெரியும்படி"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తెరిచిన కుట్ల రెండు వరుసలను టేపెస్ట్రీ సూదితో కలపండి, కలయిక అల్లికలా కనిపించేలా"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เย็บสองแถวของห่วงที่ยังไม่ปิดด้วยเข็มปักผ้า ให้รอยต่อดูเหมือนงานถัก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki sıra açık ilmeği bir tapestri iğnesiyle birleştir, dikiş örgü gibi görünsün"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зшити два ряди відкритих петель голкою так, щоб шов виглядав як в’язання"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کھلے ٹانکوں کی دو قطاروں کو سلائی کی سوئی سے جوڑیں تاکہ جوڑ بُنائی جیسا لگے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khâu hai hàng mũi chờ bằng kim khâu len để mối nối trông như đan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用缝针把两排活针缝合在一起，使接缝看起来像编织"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用縫針把兩排活針縫合在一起，使接縫看起來像編織"
          }
        }
      }
    },
