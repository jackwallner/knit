    "Work the stitches after the * again and again, as far as the row says": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Treballar els punts després de l’* una vegada i una altra, fins on digui la renglera"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opakovat oka za * stále dokola, tak daleko, jak říká řada"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Strik maskerne efter * igen og igen, så langt rækken siger"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Maschen nach dem * immer wieder arbeiten, so weit die Reihe es sagt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repetir los puntos después del * una y otra vez, hasta donde diga la hilera"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Repetir los puntos después del * una y otra vez, hasta donde diga la hilera"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toista *:n jälkeiset silmukat yhä uudelleen niin pitkälle kuin rivi sanoo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retricoter les mailles après le * encore et encore, aussi loin que le rang l’indique"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Retricoter les mailles après le * encore et encore, aussi loin que le rang l’indique"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavorare di nuovo le maglie dopo l’* più volte, fin dove indica il ferro"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Strikk maskene etter * om og om igjen, så langt raden sier"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werk de steken na de * steeds opnieuw, zo ver als de rij aangeeft"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przerabiać oczka po * wielokrotnie, tak daleko, jak mówi rząd"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repetir os pontos depois do * de novo e de novo, até onde a carreira indicar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
