    "Your purchase went through. Tap Restore if the patterns stay locked.": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva compra s’ha completat. Toca Restaura si els patrons continuen bloquejats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákup proběhl. Pokud zůstanou návody zamčené, klepněte na Obnovit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit køb gik igennem. Tryk på Gendan, hvis opskrifterne forbliver låst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf wurde abgeschlossen. Tippe auf „Wiederherstellen“, falls die Muster gesperrt bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra se completó. Toca Restaurar si los patrones siguen bloqueados."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra se completó. Toca Restaurar si los patrones siguen bloqueados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostoksesi onnistui. Napauta Palauta, jos ohjeet pysyvät lukittuina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat a abouti. Touchez Restaurer si les modèles restent verrouillés."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat a abouti. Touchez Restaurer si les modèles restent verrouillés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo acquisto è andato a buon fine. Tocca Ripristina se gli schemi restano bloccati."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøpet ditt gikk gjennom. Trykk på Gjenopprett hvis oppskriftene forblir låst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je aankoop is gelukt. Tik op Herstel als de patronen vergrendeld blijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakup się powiódł. Stuknij Przywróć, jeśli wzory nadal są zablokowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua compra foi concluída. Toque em Restaurar se as receitas continuarem bloqueadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua compra foi concluída. Toca em Restaurar se os padrões continuarem bloqueados."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákup prebehol. Ak návody zostanú zamknuté, ťuknite na Obnoviť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt köp gick igenom. Tryck på Återställ om mönstren förblir låsta."
          }
        }
      }
    }
  },
  "version": "1.0"
