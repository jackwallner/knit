    "Renews until you cancel in Settings. A pattern you cast on is yours to keep.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجدد حتى تلغيه من الإعدادات. النمط الذي بدأته يبقى ملكك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি সেটিংসে বাতিল না করা পর্যন্ত নবায়ন হতে থাকে। আপনার শুরু করা প্যাটার্ন আপনারই থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es renova fins que cancel·lis a Configuració. Un patró que hagis començat és teu per sempre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovuje se, dokud ho nezrušíte v Nastavení. Návod, který jste začali plést, vám zůstane."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornyes, indtil du opsiger i Indstillinger. En opskrift, du er gået i gang med, er din at beholde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlängert sich, bis du in den Einstellungen kündigst. Ein Muster, das du angeschlagen hast, bleibt dir erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανανεώνεται μέχρι να ακυρώσεις από τις Ρυθμίσεις. Ένα σχέδιο που έχεις ξεκινήσει παραμένει δικό σου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva hasta que canceles en Ajustes. Un patrón que hayas empezado es tuyo para siempre."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva hasta que canceles en Ajustes. Un patrón que hayas empezado es tuyo para siempre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uusiutuu, kunnes perut asetuksissa. Aloittamasi ohje pysyy sinulla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renouvelle jusqu’à ce que vous résiliez dans Réglages. Un modèle que vous avez commencé reste à vous."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renouvelle jusqu’à ce que vous résiliez dans Réglages. Un modèle que vous avez commencé reste à vous."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે સેટિંગ્સમાં રદ ન કરો ત્યાં સુધી નવીકરણ થતું રહે છે. તમે શરૂ કરેલી પેટર્ન તમારી જ રહે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתחדש עד שתבטל בהגדרות. דוגמה שהתחלת נשארת שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आप सेटिंग में रद्द नहीं करते, नवीनीकरण होता रहता है। आपका शुरू किया हुआ पैटर्न आपका ही रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnavlja se dok ne otkažete u Postavkama. Uzorak koji ste započeli ostaje vaš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megújul, amíg a Beállításokban le nem mondod. A megkezdett minta a tiéd marad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperpanjang sampai Anda membatalkan di Pengaturan. Pola yang sudah Anda mulai tetap milik Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rinnova finché non annulli in Impostazioni. Uno schema che hai avviato resta tuo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」で解約するまで更新されます。作り始めた編み図はずっとあなたのものです。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ರದ್ದುಪಡಿಸುವವರೆಗೆ ನವೀಕರಣಗೊಳ್ಳುತ್ತಲೇ ಇರುತ್ತದೆ. ನೀವು ಆರಂಭಿಸಿದ ಪ್ಯಾಟರ್ನ್ ನಿಮ್ಮದೇ ಆಗಿರುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 해지할 때까지 갱신돼요. 시작한 도안은 계속 내 것으로 남아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്രമീകരണങ്ങളിൽ റദ്ദാക്കുന്നതുവരെ പുതുക്കപ്പെടും. നിങ്ങൾ തുടങ്ങിയ പാറ്റേൺ നിങ്ങളുടേതായി തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही सेटिंग्जमध्ये रद्द करेपर्यंत नूतनीकरण होत राहते. तुम्ही सुरू केलेला पॅटर्न तुमचाच राहतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperbaharui sehingga anda membatalkan dalam Tetapan. Corak yang anda sudah mulakan kekal milik anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornyes til du sier opp i Innstillinger. En oppskrift du har startet på er din å beholde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt verlengd tot je opzegt in Instellingen. Een patroon dat je hebt opgezet blijft van jou."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ସେଟିଂସରେ ବାତିଲ୍ ନକରିବା ପର୍ଯ୍ୟନ୍ତ ନବୀକରଣ ହୋଇଥାଏ। ଆପଣ ଆରମ୍ଭ କରିଥିବା ପାଟର୍ନ ଆପଣଙ୍କର ହିଁ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਤੱਕ ਤੁਸੀਂ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਰੱਦ ਨਹੀਂ ਕਰਦੇ, ਨਵਿਆਇਆ ਜਾਂਦਾ ਰਹਿੰਦਾ ਹੈ। ਤੁਹਾਡਾ ਸ਼ੁਰੂ ਕੀਤਾ ਪੈਟਰਨ ਤੁਹਾਡਾ ਹੀ ਰਹਿੰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odnawia się, dopóki nie anulujesz w Ustawieniach. Rozpoczęty wzór zostaje Twój."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renova até você cancelar em Ajustes. Uma receita que você começou é sua para sempre."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Renova até cancelares em Definições. Um padrão que tenhas começado é teu para sempre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reînnoiește până anulezi din Setări. Un model pe care l-ai început rămâne al tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продлевается, пока вы не отмените в Настройках. Начатая вами схема остаётся у вас."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovuje sa, kým ho nezrušíte v Nastaveniach. Návod, ktorý ste začali plesť, vám zostane."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Se obnavlja, dokler ne prekličete v Nastavitvah. Vzorec, ki ste ga začeli, ostane vaš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förnyas tills du avbryter i Inställningar. Ett mönster du har lagt upp är ditt att behålla."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் அமைப்புகளில் ரத்து செய்யும் வரை புதுப்பிக்கப்படும். நீங்கள் தொடங்கிய வடிவம் உங்களுடையதாகவே இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు సెట్టింగ్‌లలో రద్దు చేసే వరకు పునరుద్ధరించబడుతుంది. మీరు మొదలుపెట్టిన ప్యాటర్న్ మీదే ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต่ออายุอัตโนมัติจนกว่าคุณจะยกเลิกในการตั้งค่า แพตเทิร์นที่คุณเริ่มทำแล้วยังเป็นของคุณตลอดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar'dan iptal edene kadar yenilenir. Başladığınız model sizde kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поновлюється, доки ви не скасуєте в Параметрах. Розпочата вами схема залишається у вас."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
