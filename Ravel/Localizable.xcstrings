    "%lld days free, then %@. Auto-renews until canceled.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld أيام مجانًا، ثم %@. يتجدد تلقائيًا حتى تلغيه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld দিন বিনামূল্যে, তারপর %@। আপনি বাতিল না করা পর্যন্ত স্বয়ংক্রিয়ভাবে নবায়ন হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dies gratis, després %@. Es renova automàticament fins que cancel·lis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dní zdarma, poté %@. Obnovuje se automaticky, dokud nezrušíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dage gratis, derefter %@. Fornyes automatisk, indtil du opsiger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Tage gratis, danach %@. Verlängert sich automatisch, bis du kündigst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ημέρες δωρεάν, έπειτα %@. Ανανεώνεται αυτόματα μέχρι να ακυρώσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld días gratis, después %@. Se renueva automáticamente hasta que canceles."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld días gratis, después %@. Se renueva automáticamente hasta que canceles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld päivää ilmaiseksi, sitten %@. Uusiutuu automaattisesti, kunnes perut."
