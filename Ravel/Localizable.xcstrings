    "Every design in the library, written to your measurements and yarn": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل تصميم في المكتبة، مكتوب وفق قياساتك وخيطك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইব্রেরির প্রতিটি ডিজাইন, আপনার মাপ ও উল অনুযায়ী লেখা"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tots els dissenys de la biblioteca, escrits a la teva mida i amb la teva llana"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý návrh v knihovně, napsaný podle vašich měr a příze"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle designs i biblioteket, skrevet efter dine mål og dit garn"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Muster der Bibliothek, passend zu deinen Maßen und deinem Garn geschrieben"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε σχέδιο της βιβλιοθήκης, γραμμένο στις μετρήσεις και στο νήμα σου"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los diseños de la biblioteca, escritos a tus medidas y tu lana"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los diseños de la biblioteca, escritos a tus medidas y a tu estambre"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki kirjaston mallit kirjoitettuna sinun mittoihisi ja lankaasi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les modèles de la bibliothèque, écrits à vos mesures et pour votre laine"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les modèles de la bibliothèque, écrits à vos mesures et pour votre laine"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લાઇબ્રેરીની દરેક ડિઝાઇન, તમારા માપ અને ઊન મુજબ લખેલી"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל עיצוב בספרייה, כתוב לפי המידות והחוט שלך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइब्रेरी का हर डिज़ाइन, आपकी नाप और ऊन के अनुसार लिखा हुआ"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki dizajn u knjižnici, napisan prema vašim mjerama i pređi"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A könyvtár minden mintája, a te méreteidre és a te fonalodra írva"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap desain di pustaka, ditulis sesuai ukuran tubuh dan benang Anda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni modello della libreria, scritto sulle tue misure e sul tuo filato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリのすべてのデザインが、あなたの寸法と毛糸に合わせて書き出されます"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಲೈಬ್ರರಿಯ ಪ್ರತಿ ವಿನ್ಯಾಸ, ನಿಮ್ಮ ಅಳತೆ ಮತ್ತು ಉಣ್ಣೆಗೆ ತಕ್ಕಂತೆ ಬರೆಯಲಾಗಿದೆ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리의 모든 디자인이 내 치수와 실에 맞춰 작성돼요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലൈബ്രറിയിലെ ഓരോ ഡിസൈനും, നിങ്ങളുടെ അളവിനും കമ്പിളിക്കും അനുസരിച്ച് എഴുതിയത്"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लायब्ररीतील प्रत्येक डिझाइन, तुमच्या मापांनुसार आणि लोकरीनुसार लिहिलेले"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap reka bentuk dalam pustaka, ditulis mengikut ukuran dan benang anda"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle designene i biblioteket, skrevet etter dine mål og ditt garn"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk ontwerp in de bibliotheek, geschreven op jouw maten en garen"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଲାଇବ୍ରେରୀର ପ୍ରତ୍ୟେକ ଡିଜାଇନ୍, ଆପଣଙ୍କ ମାପ ଓ ଊଲ୍ ଅନୁସାରେ ଲେଖାଯାଇଛି"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲਾਇਬ੍ਰੇਰੀ ਦਾ ਹਰ ਡਿਜ਼ਾਈਨ, ਤੁਹਾਡੇ ਮਾਪ ਅਤੇ ਉੱਨ ਮੁਤਾਬਕ ਲਿਖਿਆ ਹੋਇਆ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy wzór z biblioteki, napisany pod Twoje wymiary i włóczkę"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os modelos da biblioteca, escritos para as suas medidas e o seu fio"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os modelos da biblioteca, escritos para as tuas medidas e o teu fio"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare design din bibliotecă, scris după măsurile și firul tău"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все модели из библиотеки, рассчитанные по вашим меркам и пряже"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý dizajn v knižnici, napísaný podľa vašich mier a priadze"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsak dizajn v knjižnici, napisan po vaših merah in preji"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje design i biblioteket, skriven efter dina mått och ditt garn"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நூலகத்தில் உள்ள ஒவ்வொரு வடிவமைப்பும், உங்கள் அளவுக்கும் நூலுக்கும் ஏற்ப எழுதப்பட்டது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లైబ్రరీలోని ప్రతి డిజైన్, మీ కొలతలకు మరియు ఉన్నికి తగినట్లు రాయబడింది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกดีไซน์ในคลัง เขียนตามขนาดตัวและเส้นไหมของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kütüphanedeki her tasarım, ölçülerinize ve ipliğinize göre yazılır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі моделі з бібліотеки, розраховані за вашими мірками та пряжею"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لائبریری کا ہر ڈیزائن، آپ کی پیمائش اور اون کے مطابق لکھا ہوا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thiết kế trong thư viện, viết theo số đo và loại len của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
