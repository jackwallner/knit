    "Measure around the head, just above the ears. The hat is knitted a little smaller, so it stays on.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قِس حول الرأس، فوق الأذنين مباشرة. تُحاك القبعة أصغر قليلًا لتثبت في مكانها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কানের ঠিক উপর দিয়ে মাথার চারপাশ মাপুন। টুপিটি একটু ছোট করে বোনা হয়, যাতে এটি জায়গায় থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesura al voltant del cap, just per sobre de les orelles. El barret es teixeix una mica més petit perquè no es mogui."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změřte obvod hlavy těsně nad ušima. Čepice se plete o něco menší, aby držela."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mål rundt om hovedet, lige over ørerne. Huen strikkes lidt mindre, så den bliver siddende."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miss rund um den Kopf, knapp über den Ohren. Die Mütze wird etwas kleiner gestrickt, damit sie hält."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μέτρα γύρω από το κεφάλι, ακριβώς πάνω από τα αυτιά. Το σκουφάκι πλέκεται λίγο πιο μικρό, ώστε να μένει στη θέση του."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide alrededor de la cabeza, justo por encima de las orejas. El gorro se teje un poco más pequeño para que se quede en su sitio."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide alrededor de la cabeza, justo por encima de las orejas. El gorro se teje un poco más pequeño para que se quede en su sitio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittaa pään ympärys heti korvien yläpuolelta. Pipo neulotaan hieman pienemmäksi, jotta se pysyy päässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesurez le tour de tête, juste au-dessus des oreilles. Le bonnet est tricoté un peu plus petit pour bien tenir."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesurez le tour de tête, juste au-dessus des oreilles. Le bonnet est tricoté un peu plus petit pour bien tenir."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કાનની બરાબર ઉપરથી માથાનો ઘેરાવો માપો. ટોપી થોડી નાની ગૂંથાય છે, જેથી તે ટકી રહે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מדוד את היקף הראש, ממש מעל האוזניים. הכובע נסרג קצת קטן יותר, כדי שיישאר במקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कानों के ठीक ऊपर से सिर का घेरा नापें। टोपी थोड़ी छोटी बुनी जाती है, ताकि वह टिकी रहे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izmjerite opseg glave, odmah iznad ušiju. Kapa se plete malo manja kako bi ostala na mjestu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mérd meg a fej kerületét, közvetlenül a fül felett. A sapka kicsit kisebbre készül, hogy rajta maradjon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukur lingkar kepala, tepat di atas telinga. Topi dirajut sedikit lebih kecil agar tidak mudah lepas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misura intorno alla testa, appena sopra le orecchie. Il cappello è lavorato un po' più piccolo, così resta su."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "耳のすぐ上で頭周りを測ります。帽子は少し小さめに編むので、ずれにくくなります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಿವಿಗಳ ಸ್ವಲ್ಪ ಮೇಲೆ ತಲೆಯ ಸುತ್ತಳತೆಯನ್ನು ಅಳೆಯಿರಿ. ಟೋಪಿಯನ್ನು ಸ್ವಲ್ಪ ಚಿಕ್ಕದಾಗಿ ಹೆಣೆಯಲಾಗುತ್ತದೆ, ಆದ್ದರಿಂದ ಅದು ಜಾರುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀 바로 위로 머리둘레를 재세요. 모자는 약간 작게 떠서 흘러내리지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചെവിക്ക് തൊട്ടുമുകളിൽ തലയുടെ ചുറ്റളവ് അളക്കുക. തൊപ്പി അൽപ്പം ചെറുതായി നെയ്യുന്നു, അതുകൊണ്ട് അത് ഇളകാതെ നിൽക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कानांच्या अगदी वर डोक्याचा घेर मोजा. टोपी थोडी लहान विणली जाते, म्हणजे ती जागेवर राहते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukur lilitan kepala, tepat di atas telinga. Topi dirajut sedikit lebih kecil supaya kekal di tempatnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mål rundt hodet, rett over ørene. Lua strikkes litt mindre, så den blir sittende."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meet rond je hoofd, vlak boven je oren. De muts wordt iets kleiner gebreid, zodat hij blijft zitten."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କାନର ଠିକ୍ ଉପରେ ମୁଣ୍ଡର ଘେର ମାପନ୍ତୁ। ଟୋପି ଟିକିଏ ଛୋଟ ବୁଣାଯାଏ, ଯେପରି ତାହା ଟିକି ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੰਨਾਂ ਤੋਂ ਠੀਕ ਉੱਪਰ ਸਿਰ ਦਾ ਘੇਰਾ ਮਾਪੋ। ਟੋਪੀ ਥੋੜ੍ਹੀ ਛੋਟੀ ਬੁਣੀ ਜਾਂਦੀ ਹੈ, ਤਾਂ ਜੋ ਇਹ ਟਿਕੀ ਰਹੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmierz obwód głowy tuż nad uszami. Czapka jest robiona trochę mniejsza, żeby dobrze trzymała się na głowie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meça em volta da cabeça, logo acima das orelhas. O gorro é tricotado um pouco menor para ficar no lugar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Meça em volta da cabeça, logo acima das orelhas. O gorro é tricotado um pouco menor para ficar no lugar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Măsoară în jurul capului, chiar deasupra urechilor. Căciula se tricotează puțin mai mică, ca să rămână pe loc."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измерьте обхват головы чуть выше ушей. Шапка вяжется немного меньше, чтобы хорошо держаться."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmerajte obvod hlavy tesne nad ušami. Čiapka sa pletie o niečo menšia, aby držala."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izmerite obseg glave, tik nad ušesi. Kapa je spletena malo manjša, da ostane na mestu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mät runt huvudet, strax ovanför öronen. Mössan stickas lite mindre så att den sitter kvar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காதுகளுக்கு சற்று மேலே தலையைச் சுற்றி அளவிடுங்கள். தொப்பி சற்று சிறியதாகப் பின்னப்படுகிறது, அதனால் அது நழுவாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చెవులకు కొంచెం పైన తల చుట్టుకొలతను కొలవండి. టోపీ కొంచెం చిన్నగా అల్లబడుతుంది, అందువల్ల అది జారదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วัดรอบศีรษะเหนือหูเล็กน้อย หมวกจะถักให้เล็กลงนิดหน่อย เพื่อให้อยู่กับที่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kulakların hemen üstünden baş çevresini ölçün. Bere biraz daha küçük örülür, böylece yerinde kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виміряйте обхват голови трохи вище вух. Шапку в’яжуть трохи меншою, щоб добре трималася."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کانوں کے بالکل اوپر سر کے گرد ناپیں۔ ٹوپی تھوڑی چھوٹی بُنی جاتی ہے، تاکہ وہ اپنی جگہ پر رہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đo vòng quanh đầu, ngay trên tai. Mũ được đan nhỏ hơn một chút để không bị tuột."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在耳朵上方一点测量头围。帽子会织得略小一些，这样才戴得稳。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在耳朵上方一點測量頭圍。帽子會織得略小一些，這樣才戴得穩。"
          }
        }
      }
    },
    "Medium": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوسط"
          }
        },
