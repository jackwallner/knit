          "stringUnit": {
            "state": "translated",
            "value": "Mẫu đan bạn đã bắt đầu vẫn là của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已开始的图解将永远归你"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已開始的織圖將永遠屬於你"
          }
        }
      }
    },
    "A ring on the needle that marks a spot. Slip it from the left needle to the right when you reach it": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حلقة على الإبرة تحدد مكانًا. انقلها من الإبرة اليسرى إلى اليمنى عند الوصول إليها"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাঁটায় একটি আংটা যা জায়গা চিহ্নিত করে। সেখানে পৌঁছালে বাঁ কাঁটা থেকে ডান কাঁটায় সরান"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anell a l’agulla que marca un lloc. Passa’l de l’agulla esquerra a la dreta quan hi arribis"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kroužek na jehlici, který značí místo. Až k němu dojdete, přendejte ho z levé jehlice na pravou"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En ring på pinden, der markerer et sted. Flyt den fra venstre til højre pind, når du når til den"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ring auf der Nadel, der eine Stelle markiert. Beim Erreichen von der linken auf die rechte Nadel heben"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας δακτύλιος στη βελόνα που σημαδεύει μια θέση. Πέρασέ τον από την αριστερή στη δεξιά βελόνα όταν φτάσεις σε αυτόν"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anillo en la aguja que marca un lugar. Pásalo de la aguja izquierda a la derecha al llegar a él"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anillo en la aguja que marca un lugar. Pásalo de la aguja izquierda a la derecha al llegar a él"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puikolla oleva rengas, joka merkitsee kohdan. Siirrä se vasemmalta puikolta oikealle, kun saavut siihen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anneau sur l’aiguille qui marque un endroit. Le glisser de l’aiguille gauche à la droite quand vous l’atteignez"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anneau sur l’aiguille qui marque un endroit. Le glisser de l’aiguille gauche à la droite quand vous l’atteignez"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સળી પર એક રિંગ જે જગ્યા ચિહ્નિત કરે છે. ત્યાં પહોંચો ત્યારે ડાબી સળીથી જમણી સળી પર ખસેડો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טבעת על המסרגה שמסמנת מקום. העבר אותה מהמסרגה השמאלית לימנית כשתגיע אליה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सलाई पर एक छल्ला जो जगह को चिह्नित करता है। वहाँ पहुँचने पर इसे बाईं सलाई से दाईं पर खिसकाएँ"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prsten na igli koji označava mjesto. Prebacite ga s lijeve igle na desnu kad dođete do njega"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tűn lévő gyűrű jelöl egy helyet. Ha odaérsz, húzd át a bal tűről a jobbra"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cincin di jarum yang menandai suatu tempat. Geser dari jarum kiri ke kanan saat Anda sampai"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anello sul ferro che segna un punto. Passalo dal ferro sinistro al destro quando ci arrivi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "針に通して位置を示すリング。そこに来たら左針から右針へ移す"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸೂಜಿಯ ಮೇಲೆ ಸ್ಥಳವನ್ನು ಗುರುತಿಸುವ ಉಂಗುರ. ಅದರ ಬಳಿ ಬಂದಾಗ ಎಡ ಸೂಜಿಯಿಂದ ಬಲಕ್ಕೆ ಜಾರಿಸಿ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바늘에 끼워 위치를 표시하는 고리. 거기에 닿으면 왼쪽 바늘에서 오른쪽 바늘로 옮기기"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്ഥലം അടയാളപ്പെടുത്തുന്ന സൂചിയിലെ വളയം. അവിടെ എത്തുമ്പോൾ ഇടത് സൂചിയിൽ നിന്ന് വലതിലേക്ക് മാറ്റുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सुईवरील एक कडी जी जागा चिन्हांकित करते. तिथे पोहोचल्यावर ती डाव्या सुईवरून उजवीकडे सरकवा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelang pada jarum yang menandakan sesuatu tempat. Gelongsorkan dari jarum kiri ke kanan apabila anda sampai"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En ring på pinnen som markerer et sted. Flytt den fra venstre til høyre pinne når du kommer til den"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een ring op de naald die een plek markeert. Haal hem van de linker- naar de rechternaald als je hem bereikt"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଛୁଞ୍ଚିରେ ଥିବା ଗୋଟିଏ ଆଙ୍ଗୁଠି ଯାହା ସ୍ଥାନ ଚିହ୍ନଟ କରେ। ସେଠାରେ ପହଞ୍ଚିଲେ ବାମ ଛୁଞ୍ଚିରୁ ଡାହାଣକୁ ସରକାନ୍ତୁ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਲਾਈ ਉੱਤੇ ਇੱਕ ਛੱਲਾ ਜੋ ਥਾਂ ਨੂੰ ਨਿਸ਼ਾਨਬੱਧ ਕਰਦਾ ਹੈ। ਉੱਥੇ ਪਹੁੰਚਣ ਉੱਤੇ ਖੱਬੀ ਸਲਾਈ ਤੋਂ ਸੱਜੀ ਉੱਤੇ ਖਿਸਕਾਓ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierścień na drucie, który oznacza miejsce. Przełóż go z lewego drutu na prawy, gdy do niego dojdziesz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um anel na agulha que marca um lugar. Passe-o da agulha esquerda para a direita quando chegar nele"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um anel na agulha que marca um lugar. Passe-o da agulha esquerda para a direita quando chegar nele"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un inel pe andrea care marchează un loc. Mută-l de pe andreaua stângă pe cea dreaptă când ajungi la el"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кольцо на спице, отмечающее место. Когда дойдёте до него, переложите с левой спицы на правую"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Krúžok na ihlici, ktorý značí miesto. Keď k nemu dôjdete, prehoďte ho z ľavej ihlice na pravú"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obroček na igli, ki označuje mesto. Prestavi ga z leve igle na desno, ko prideš do njega"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En ring på stickan som markerar ett ställe. Flytta den från vänster till höger sticka när du kommer till den"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஊசியில் ஓர் இடத்தைக் குறிக்கும் வளையம். அதை அடைந்ததும் இடது ஊசியிலிருந்து வலதுக்கு நகர்த்து"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సూదిపై ఒక చోటును గుర్తించే ఉంగరం. అక్కడికి చేరగానే ఎడమ సూది నుండి కుడికి జరపండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วงแหวนบนไม้ถักที่ทำเครื่องหมายตำแหน่ง เมื่อถึงให้เลื่อนจากไม้ซ้ายไปไม้ขวา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şişte bir yeri işaretleyen halka. Ona geldiğinde sol şişten sağ şişe kaydır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кільце на спиці, що позначає місце. Коли дійдете до нього, перекладіть з лівої спиці на праву"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سلائی پر ایک چھلا جو جگہ کو نشان زد کرتا ہے۔ جب اس تک پہنچیں تو بائیں سلائی سے دائیں پر منتقل کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một vòng nhỏ trên kim đánh dấu một vị trí. Khi đến nơi, trượt nó từ kim trái sang kim phải"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "套在针上标记位置的圈。织到时将它从左针移到右针"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "套在針上標記位置的圈。織到時將它從左針移到右針"
          }
        }
      }
    },
