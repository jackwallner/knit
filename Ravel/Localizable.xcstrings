    "No purchase found on this Apple Account": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على عملية شراء في حساب Apple هذا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Apple অ্যাকাউন্টে কোনো কেনাকাটা পাওয়া যায়নি"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha trobat cap compra amb aquest compte d’Apple"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro toto Apple ID se nenašel žádný nákup"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke fundet noget køb på denne Apple-konto"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Apple-ID wurde kein Kauf gefunden"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκε αγορά σε αυτόν τον Apple ID"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ninguna compra en este ID de Apple"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ninguna compra en este ID de Apple"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tällä Apple-tilillä ei löytynyt ostoksia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun achat trouvé sur cet identifiant Apple"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun achat trouvé sur cet identifiant Apple"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ Apple એકાઉન્ટ પર કોઈ ખરીદી મળી નહીં"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נמצאה רכישה בחשבון Apple הזה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Apple खाते पर कोई खरीदारी नहीं मिली"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije pronađena kupnja za ovaj Apple ID"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezen az Apple-fiókon nem található vásárlás"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ditemukan pembelian di Akun Apple ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun acquisto trovato su questo ID Apple"
