    "Every design in the library, written to your measurements and yarn": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tots els dissenys de la biblioteca, escrits a la teva mida i amb la teva llana"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý návrh v knihovně, napsaný podle vašich měr a příze"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle designs i biblioteket, skrevet efter dine mål og dit garn"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Muster der Bibliothek, passend zu deinen Maßen und deinem Garn geschrieben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los diseños de la biblioteca, escritos a tus medidas y tu lana"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los diseños de la biblioteca, escritos a tus medidas y a tu estambre"
