    "Your purchase went through. Tap Restore if the patterns stay locked.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت عملية الشراء. اضغط على «استعادة» إذا بقيت الأنماط مقفلة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেনাকাটা সম্পন্ন হয়েছে। প্যাটার্ন লক থাকলে পুনরুদ্ধারে ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva compra s’ha completat. Toca Restaura si els patrons continuen bloquejats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákup proběhl. Pokud zůstanou návody zamčené, klepněte na Obnovit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit køb gik igennem. Tryk på Gendan, hvis opskrifterne forbliver låst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf wurde abgeschlossen. Tippe auf „Wiederherstellen“, falls die Muster gesperrt bleiben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αγορά ολοκληρώθηκε. Πάτα Επαναφορά αν τα σχέδια παραμένουν κλειδωμένα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra se completó. Toca Restaurar si los patrones siguen bloqueados."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra se completó. Toca Restaurar si los patrones siguen bloqueados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostoksesi onnistui. Napauta Palauta, jos ohjeet pysyvät lukittuina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat a abouti. Touchez Restaurer si les modèles restent verrouillés."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat a abouti. Touchez Restaurer si les modèles restent verrouillés."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખરીદી પૂર્ણ થઈ. પેટર્ન લૉક રહે તો પુનઃસ્થાપિત કરો પર ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרכישה הושלמה. הקש על שחזר אם הדוגמאות נשארות נעולות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खरीदारी पूरी हो गई। अगर पैटर्न लॉक रहें तो बहाल करें पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupnja je uspjela. Dodirnite Vrati kupnju ako uzorci ostanu zaključani."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vásárlás sikerült. Koppints a Visszaállításra, ha a minták zárva maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian berhasil. Ketuk Pulihkan jika pola tetap terkunci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo acquisto è andato a buon fine. Tocca Ripristina se gli schemi restano bloccati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご購入が完了しました。編み図がロックされたままの場合は「復元」をタップしてください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಖರೀದಿ ಪೂರ್ಣಗೊಂಡಿದೆ. ಪ್ಯಾಟರ್ನ್‌ಗಳು ಲಾಕ್ ಆಗಿಯೇ ಇದ್ದರೆ ಮರುಸ್ಥಾಪಿಸಿ ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구입이 완료됐어요. 도안이 계속 잠겨 있으면 복원을 탭하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വാങ്ങൽ പൂർത്തിയായി. പാറ്റേണുകൾ ലോക്ക് ആയി തുടരുകയാണെങ്കിൽ വീണ്ടെടുക്കുക ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खरेदी पूर्ण झाली. पॅटर्न लॉक राहिल्यास पुनर्संचयित करा वर टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian berjaya. Ketik Pulihkan jika corak kekal terkunci."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøpet ditt gikk gjennom. Trykk på Gjenopprett hvis oppskriftene forblir låst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je aankoop is gelukt. Tik op Herstel als de patronen vergrendeld blijven."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କିଣା ସମ୍ପୂର୍ଣ୍ଣ ହେଲା। ପାଟର୍ନ ଲକ୍ ରହିଲେ ପୁନଃସ୍ଥାପନ କରନ୍ତୁରେ ଟ୍ୟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਖਰੀਦ ਪੂਰੀ ਹੋ ਗਈ। ਜੇ ਪੈਟਰਨ ਲੌਕ ਰਹਿਣ ਤਾਂ ਬਹਾਲ ਕਰੋ ਉੱਤੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakup się powiódł. Stuknij Przywróć, jeśli wzory nadal są zablokowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua compra foi concluída. Toque em Restaurar se as receitas continuarem bloqueadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua compra foi concluída. Toca em Restaurar se os padrões continuarem bloqueados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Achiziția a reușit. Atinge Restabilește dacă modelele rămân blocate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка прошла. Нажмите «Восстановить», если схемы остаются закрытыми."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákup prebehol. Ak návody zostanú zamknuté, ťuknite na Obnoviť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakup je uspel. Tapnite Obnovi, če vzorci ostanejo zaklenjeni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt köp gick igenom. Tryck på Återställ om mönstren förblir låsta."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வாங்குதல் முடிந்தது. வடிவங்கள் பூட்டியே இருந்தால் மீட்டெடு என்பதைத் தட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొనుగోలు పూర్తయింది. ప్యాటర్న్‌లు లాక్ అయి ఉంటే పునరుద్ధరించండి నొక్కండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การซื้อสำเร็จแล้ว แตะ กู้คืน หากแพตเทิร์นยังถูกล็อกอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alım tamamlandı. Modeller kilitli kalırsa Geri Yükle'ye dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупку виконано. Торкніться «Відновити», якщо схеми залишаються закритими."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خریداری مکمل ہو گئی۔ اگر پیٹرنز بند رہیں تو بحال کریں پر ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch mua đã hoàn tất. Hãy chạm Khôi phục nếu các mẫu đan vẫn bị khóa."
